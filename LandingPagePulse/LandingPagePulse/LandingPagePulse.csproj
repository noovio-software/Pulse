<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Comme AltPulse : VERSION est posée par GitHub Actions et lue ici ; 1.0.0 en local. -->
    <Version>$(Version)</Version>
    <!-- Textes neutres en français, anglais en assembly satellite. -->
    <NeutralLanguage>fr</NeutralLanguage>
  </PropertyGroup>

  <!-- Textes de la page, en français (neutre) et en anglais. La classe d'accès LandingTexts.Designer.cs est versionnée
       à côté du .resx ; l'IDE la régénère quand on enregistre le .resx. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\LandingTexts.resx" Generator="ResXFileCodeGenerator" LastGenOutput="LandingTexts.Designer.cs" />
    <Compile Update="Resources\LandingTexts.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="LandingTexts.resx" />
  </ItemGroup>

</Project>
