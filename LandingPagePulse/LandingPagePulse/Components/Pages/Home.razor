@page "/"

<PageTitle>Noovio · Outils World of Warcraft : AltPulse, FrontPulse, LifePulse et BurstPulse</PageTitle>

<HeadContent>
    <link rel="canonical" href="https://www.noovio.fr/" />
    <meta name="description" content="Noovio réunit quatre outils World of Warcraft : AltPulse pour suivre tous tes personnages dans une seule grille, FrontPulse, LifePulse et BurstPulse pour jouer ton tank, ton soigneur ou ton DPS comme le top 100 en Mythique+, et l'addon NoovioPulse pour les nourrir depuis le jeu." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Noovio" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="https://www.noovio.fr/" />
    <meta property="og:title" content="Noovio · Prends le pouls de tes personnages" />
    <meta property="og:description" content="AltPulse pour suivre tous tes personnages, FrontPulse, LifePulse et BurstPulse pour jouer ton tank, ton soigneur ou ton DPS comme le top 100 en Mythique+." />
    <meta property="og:image" content="https://www.noovio.fr/og-noovio.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

<main class="shell">
    @* --- Accroche ------------------------------------------------------------------------------ *@
    <section class="hero">
        <h1 class="hero-title">Prends le pouls <em>de tes personnages</em></h1>
        <p class="hero-lead">
            Un outil pour savoir où en sont tous tes personnages cette semaine, trois autres pour jouer ton tank,
            ton soigneur ou ton DPS comme les meilleurs. Choisis ta porte.
        </p>
    </section>

    @* Le tracé relie les quatre outils : un battement par outil, dans l'ordre des portes et à la couleur de chacun. *@
    <svg class="heartbeat" viewBox="0 0 1200 96" preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="heartbeat-color" x1="0" y1="0" x2="1200" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#4DFF88" />
                <stop offset="0.2" stop-color="#4DFF88" />
                <stop offset="0.3" stop-color="#F59E0B" />
                <stop offset="0.45" stop-color="#F59E0B" />
                <stop offset="0.55" stop-color="#4FA8F7" />
                <stop offset="0.7" stop-color="#4FA8F7" />
                <stop offset="0.8" stop-color="#A78BFA" />
                <stop offset="1" stop-color="#A78BFA" />
            </linearGradient>
        </defs>
        <path class="heartbeat-base" d="@HeartbeatPath" stroke="url(#heartbeat-color)" />
        <path class="heartbeat-spark" d="@HeartbeatPath" stroke="url(#heartbeat-color)" pathLength="100" />
    </svg>

    @* --- Les quatre portes, deux par rangée : le lien couvre toute la carte (::after) -------------- *@
    <section class="doors" aria-label="Les outils">
        <article class="panel door tool-alt">
            <div class="door-pattern" aria-hidden="true"></div>
            <header class="door-head">
                <ToolSigil Size="34" />
                <span class="door-wordmark">
                    <span class="door-name">AltPulse</span>
                    <span class="door-by">by Noovio</span>
                </span>
                <span class="door-badge">Tous tes personnages</span>
            </header>
            <h2 class="door-title">Toute ta semaine, une seule grille</h2>
            <p class="door-lead">
                Une colonne par personnage : niveau d'objet, score, clés, Grande Chambre forte, meilleure clé
                par donjon et raids de la semaine. Fini de reconnecter chaque perso pour vérifier.
            </p>

            <div class="preview" aria-hidden="true">
                <span class="preview-tag">Exemple</span>
                <div class="alt-grid">
                    <span></span>
                    <strong style="--class: #C69B6D">Guerrier</strong>
                    <strong style="--class: #3FC7EB">Mage</strong>
                    <strong style="--class: #F48CBA">Paladin</strong>

                    <span>Niveau d'objet</span><b>284</b><b>279</b><b>263</b>
                    <span>Score M+</span><b>3 120</b><b>2 480</b><b>1 655</b>
                    <span>Clés semaine</span><b>8</b><b>4</b><b>1</b>
                    <span>Chambre forte</span>
                    <i class="vault"><u class="on"></u><u class="on"></u><u class="on"></u></i>
                    <i class="vault"><u class="on"></u><u class="on"></u><u></u></i>
                    <i class="vault"><u class="on"></u><u></u><u></u></i>
                </div>
            </div>

            <footer class="door-foot">
                <a class="door-link" href="altpulse">
                    Ouvrir AltPulse
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <span class="door-note">Sans compte, ton historique reste dans ton navigateur</span>
            </footer>
        </article>

        <article class="panel door tool-front">
            <div class="door-pattern" aria-hidden="true"></div>
            <header class="door-head">
                <ToolSigil Front Size="34" />
                <span class="door-wordmark">
                    <span class="door-name">FrontPulse</span>
                    <span class="door-by">by Noovio</span>
                </span>
                <span class="door-badge">Ton tank en Mythique+</span>
            </header>
            <h2 class="door-title">Joue ton tank comme le top 100</h2>
            <p class="door-lead">
                Caractéristiques, talents, équipement et bijoux des 100 meilleurs tanks de chaque spécialisation.
                Compare ton personnage et repars avec ce qu'il faut changer en premier.
            </p>

            <div class="preview" aria-hidden="true">
                <span class="preview-tag">Exemple</span>
                <div class="report">
                    <div class="score" style="--score: 78">
                        <strong>78</strong>
                        <small>/ 100</small>
                    </div>
                    <ul class="gauges">
                        <li style="--stat: #F59E0B; --you: 92%; --top: 88%"><span>Hâte</span><i></i></li>
                        <li style="--stat: #8B5CF6; --you: 44%; --top: 66%"><span>Maîtrise</span><i></i></li>
                        <li style="--stat: #38BDF8; --you: 40%; --top: 48%"><span>Polyvalence</span><i></i></li>
                        <li style="--stat: #F87171; --you: 34%; --top: 22%"><span>Critique</span><i></i></li>
                    </ul>
                </div>
                <span class="legend"><u></u> ton perso <u class="is-top"></u> médiane du top</span>
            </div>

            <footer class="door-foot">
                <a class="door-link" href="frontpulse">
                    Ouvrir FrontPulse
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <span class="door-note">Méta recalculée toutes les 6 h, comparaison via Battle.net</span>
            </footer>
        </article>

        <article class="panel door tool-life">
            <div class="door-pattern" aria-hidden="true"></div>
            <header class="door-head">
                <ToolSigil Life Size="34" />
                <span class="door-wordmark">
                    <span class="door-name">LifePulse</span>
                    <span class="door-by">by Noovio</span>
                </span>
                <span class="door-badge">Ton soigneur en Mythique+</span>
            </header>
            <h2 class="door-title">Joue ton soigneur comme le top 100</h2>
            <p class="door-lead">
                Caractéristiques, talents, équipement et bijoux des 100 meilleurs soigneurs, sur les sept spécialisations de soin.
                Compare ton personnage et repars avec ce qu'il faut changer en premier.
            </p>

            <div class="preview" aria-hidden="true">
                <span class="preview-tag">Exemple</span>
                <div class="report">
                    <div class="score" style="--score: 84">
                        <strong>84</strong>
                        <small>/ 100</small>
                    </div>
                    <ul class="gauges">
                        <li style="--stat: #4FA8F7; --you: 86%; --top: 90%"><span>Hâte</span><i></i></li>
                        <li style="--stat: #F87171; --you: 58%; --top: 52%"><span>Critique</span><i></i></li>
                        <li style="--stat: #8B5CF6; --you: 36%; --top: 46%"><span>Maîtrise</span><i></i></li>
                        <li style="--stat: #2DD4BF; --you: 30%; --top: 28%"><span>Polyvalence</span><i></i></li>
                    </ul>
                </div>
                <span class="legend"><u></u> ton perso <u class="is-top"></u> médiane du top</span>
            </div>

            <footer class="door-foot">
                <a class="door-link" href="lifepulse">
                    Ouvrir LifePulse
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <span class="door-note">Méta recalculée toutes les 6 h, comparaison via Battle.net</span>
            </footer>
        </article>

        <article class="panel door tool-burst">
            <div class="door-pattern" aria-hidden="true"></div>
            <header class="door-head">
                <ToolSigil Burst Size="34" />
                <span class="door-wordmark">
                    <span class="door-name">BurstPulse</span>
                    <span class="door-by">by Noovio</span>
                </span>
                <span class="door-badge">Ton DPS en Mythique+</span>
            </header>
            <h2 class="door-title">Joue ton DPS comme le top 100</h2>
            <p class="door-lead">
                Caractéristiques, talents, équipement et bijoux des 100 meilleurs DPS, sur les vingt-sept spécialisations de dégâts.
                Compare ton personnage et repars avec ce qu'il faut changer en premier.
            </p>

            <div class="preview" aria-hidden="true">
                <span class="preview-tag">Exemple</span>
                <div class="report">
                    <div class="score" style="--score: 71">
                        <strong>71</strong>
                        <small>/ 100</small>
                    </div>
                    <ul class="gauges">
                        <li style="--stat: #F87171; --you: 80%; --top: 88%"><span>Critique</span><i></i></li>
                        <li style="--stat: #FB923C; --you: 66%; --top: 62%"><span>Hâte</span><i></i></li>
                        <li style="--stat: #8B5CF6; --you: 38%; --top: 50%"><span>Maîtrise</span><i></i></li>
                        <li style="--stat: #FBBF24; --you: 26%; --top: 20%"><span>Polyvalence</span><i></i></li>
                    </ul>
                </div>
                <span class="legend"><u></u> ton perso <u class="is-top"></u> médiane du top</span>
            </div>

            <footer class="door-foot">
                <a class="door-link" href="burstpulse">
                    Ouvrir BurstPulse
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <span class="door-note">Méta recalculée toutes les 6 h, comparaison via Battle.net</span>
            </footer>
        </article>
    </section>

    @* --- L'addon NoovioPulse : il nourrit les quatre outils depuis le jeu ------------------------------ *@
    <section class="panel addon tool-addon" aria-labelledby="addon-title">
        <div class="addon-text">
            <header class="door-head">
                <span class="tool-sigil addon-sigil" aria-hidden="true">
                    <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="26" height="26" rx="7" stroke-width="2" />
                        <path d="M7 17h5l2-6 4 11 2.5-7H25" stroke-width="2.2" />
                    </svg>
                </span>
                <span class="door-wordmark">
                    <span class="door-name">NoovioPulse</span>
                    <span class="door-by">l'addon World of Warcraft</span>
                </span>
                <span class="door-badge">Nouveau · gratuit</span>
            </header>
            <h2 class="door-title" id="addon-title">Ton personnage tel qu'il est, à la minute</h2>
            <p class="door-lead">
                Tape <code>/noovio</code> en jeu, copie la chaîne, colle-la sur l'outil. Pas besoin d'attendre que Blizzard
                mette ton profil à jour, ni de te connecter, et l'analyse voit enfin ce que Battle.net ignore :
                tes sacs et ta Grande Chambre forte.
            </p>

            <ul class="addon-exports">
                <li>
                    <strong>Mon personnage</strong>
                    <span>
                        Équipement, talents, sacs, coffre et consommables, analysés face au top 100 sur
                        <a class="tool-front" href="frontpulse">FrontPulse</a>, <a class="tool-life" href="lifepulse">LifePulse</a>
                        ou <a class="tool-burst" href="burstpulse">BurstPulse</a>.
                    </span>
                </li>
                <li>
                    <strong>Mes alts</strong>
                    <span>
                        Coffre, clés de la semaine et clé en poche de tous tes personnages, en un seul collage sur
                        <a class="tool-alt" href="altpulse">AltPulse</a>.
                    </span>
                </li>
            </ul>

            <footer class="door-foot">
                <a class="door-link" href="addon">
                    Télécharger l'addon
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M6 11l6 6 6-6M5 20h14" /></svg>
                </a>
                <span class="door-note">Dossier à déposer dans Interface\AddOns · bientôt sur CurseForge</span>
            </footer>
        </div>

        @* Aperçu : la chaîne copiée en jeu, puis le bloc « Sacs et coffre » du rapport (valeurs fictives). *@
        <div class="preview addon-preview" aria-hidden="true">
            <span class="preview-tag">Exemple</span>
            <div class="addon-string">
                <span class="addon-step">1</span>
                <code>/noovio</code>
                <span class="addon-arrow">→</span>
                <code class="addon-code">NP1:D:eJzFWNtu4zYQ…</code>
            </div>
            <div class="addon-string">
                <span class="addon-step">2</span>
                <span>Collé sur l'outil, le rapport ajoute :</span>
            </div>
            <ul class="addon-items">
                <li>
                    <span>Bottes du coffre <small>Héros 2/6</small></span>
                    <b>330 → 346</b>
                    <i class="is-good">+22 au max</i>
                </li>
                <li>
                    <span>Jambières des sacs <small>Héros 1/6</small></span>
                    <b>327 → 346</b>
                    <i class="is-good">+28 au max</i>
                </li>
                <li>
                    <span>Flacon <small>×3</small></span>
                    <b>prêt</b>
                    <i class="is-good">✓</i>
                </li>
                <li>
                    <span>Potion de combat <small>×2</small></span>
                    <b>stock bas</b>
                    <i class="is-warn">!</i>
                </li>
            </ul>
        </div>
    </section>

    @* --- Lequel ouvrir ? -------------------------------------------------------------------------- *@
    <section class="chooser">
        <h2 class="chooser-heading">Lequel ouvrir ?</h2>
        <ul class="questions">
            <li class="tool-alt">
                <a href="altpulse">
                    <span class="question">Où en sont mes clés et ma Grande Chambre forte cette semaine ?</span>
                    <span class="answer"><ToolSigil Size="16" /> AltPulse</span>
                </a>
            </li>
            <li class="tool-front">
                <a href="frontpulse">
                    <span class="question">Quelles caractéristiques et quels talents jouent les meilleurs tanks ?</span>
                    <span class="answer"><ToolSigil Front Size="16" /> FrontPulse</span>
                </a>
            </li>
            <li class="tool-life">
                <a href="lifepulse">
                    <span class="question">Quelles caractéristiques et quels talents jouent les meilleurs soigneurs ?</span>
                    <span class="answer"><ToolSigil Life Size="16" /> LifePulse</span>
                </a>
            </li>
            <li class="tool-burst">
                <a href="burstpulse">
                    <span class="question">Quelles caractéristiques et quels talents jouent les meilleurs DPS ?</span>
                    <span class="answer"><ToolSigil Burst Size="16" /> BurstPulse</span>
                </a>
            </li>
            <li class="tool-alt">
                <a href="altpulse">
                    <span class="question">Quels boss ai-je déjà tués cette semaine, et dans quelle difficulté ?</span>
                    <span class="answer"><ToolSigil Size="16" /> AltPulse</span>
                </a>
            </li>
            <li class="tool-front">
                <a href="frontpulse">
                    <span class="question">Que changer en priorité sur mon tank ?</span>
                    <span class="answer"><ToolSigil Front Size="16" /> FrontPulse</span>
                </a>
            </li>
            <li class="tool-life">
                <a href="lifepulse">
                    <span class="question">Que changer en priorité sur mon soigneur ?</span>
                    <span class="answer"><ToolSigil Life Size="16" /> LifePulse</span>
                </a>
            </li>
            <li class="tool-burst">
                <a href="burstpulse">
                    <span class="question">Que changer en priorité sur mon DPS ?</span>
                    <span class="answer"><ToolSigil Burst Size="16" /> BurstPulse</span>
                </a>
            </li>
        </ul>
    </section>
</main>

@code {
    // Ligne plate, un battement par outil, régulièrement espacés (x = 150, 450, 750 et 1050).
    private const string HeartbeatPath =
        "M0 62H100l14-8 12 8h8l10 26 12-82 12 70 8-14h14l10-8 10 8H400l14-8 12 8h8l10 26 12-82 12 70 8-14h14l10-8 10 8H700l14-8 12 8h8l10 26 12-82 12 70 8-14h14l10-8 10 8H1000l14-8 12 8h8l10 26 12-82 12 70 8-14h14l10-8 10 8H1200";
}
