@page "/Error"

<PageTitle>@LandingTexts.Error_Title</PageTitle>

<main class="shell">
    <section class="panel empty-state">
        <h1>@LandingTexts.Error_Heading</h1>
        <p>@LandingTexts.Error_Text</p>
        @if (ShowRequestId)
        {
            <p class="muted">@LandingTexts.Error_RequestId <code>@RequestId</code></p>
        }
        <a class="btn" href="/">@LandingTexts.Common_Back</a>
    </section>
</main>
