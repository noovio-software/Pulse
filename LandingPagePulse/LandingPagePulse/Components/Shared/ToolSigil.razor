@* Emblèmes des quatre outils : mêmes tracés que leurs composants Sigil respectifs. *@

<span class="tool-sigil" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        @if (Front)
        {
            <path d="M16 3l10 4v8c0 6.5-4.2 11-10 14-5.8-3-10-7.5-10-14V7z" stroke-width="2" />
            <path d="M9 16h3.5l2-4 3 8 2-4H23" stroke-width="1.8" />
        }
        else if (Life)
        {
            <path d="M16 2.5c5.2 6.6 10.5 11.4 10.5 17.1a10.5 10.5 0 0 1-21 0C5.5 13.9 10.8 9.1 16 2.5z" stroke-width="2" />
            <path d="M9 16h3.5l2-4 3 8 2-4H23" stroke-width="1.8" />
        }
        else if (Burst)
        {
            <path d="M16 2 18.9 9 25.9 6.1 23 13.1 30 16 23 18.9 25.9 25.9 18.9 23 16 30 13.1 23 6.1 25.9 9 18.9 2 16 9 13.1 6.1 6.1 13.1 9z" stroke-width="2" />
            <path d="M9 16h3.5l2-4 3 8 2-4H23" stroke-width="1.8" />
        }
        else
        {
            <g transform="translate(0 2)">
                <path d="M16 2c5 4 9 8 9 14a9 9 0 0 1-18 0c0-6 4-10 9-14Z" stroke-width="2" />
                <path d="M12 15c1.5 2 6.5 2 8 0M13 19l1 4M19 19l-1 4" stroke-width="1.6" />
            </g>
        }
    </svg>
</span>

@code {
    /// <summary>FrontPulse (l'écu) ; sinon AltPulse (la goutte de venin).</summary>
    [Parameter] public bool Front { get; set; }

    /// <summary>LifePulse (la goutte traversée d'un pouls).</summary>
    [Parameter] public bool Life { get; set; }

    /// <summary>BurstPulse (l'étoile d'explosion traversée d'un pouls).</summary>
    [Parameter] public bool Burst { get; set; }

    [Parameter] public int Size { get; set; } = 26;
}
