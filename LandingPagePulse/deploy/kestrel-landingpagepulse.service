[Unit]
Description=LandingPagePulse by Noovio - www.noovio.fr (Kestrel)
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/projects/landingpagepulse
ExecStart=/usr/bin/dotnet /home/ubuntu/projects/landingpagepulse/LandingPagePulse.dll --urls http://127.0.0.1:8520
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=landingpagepulse
User=ubuntu
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=true

[Install]
WantedBy=multi-user.target
