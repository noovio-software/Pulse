@page "/"
@rendermode InteractiveAuto
@inject IAltPulseApi Api
@inject LocalHistoryStore Store
@inject IJSRuntime JS

<PageTitle>AltPulse by Noovio · Suivi de personnages</PageTitle>

<TopBar>
    @if (season?.Affixes is { } affixes)
    {
        <ul class="affixes" aria-label="Affixes de la semaine">
            @foreach (var a in affixes.Affixes)
            {
                <li tabindex="0">
                    @if (a.IconUrl is not null)
                    {
                        <img src="@a.IconUrl" alt="@a.Name" loading="lazy" />
                    }
                    <span class="affix-tooltip" role="tooltip">
                        <strong>@a.Name</strong>
                        @a.Description
                    </span>
                </li>
            }
        </ul>
    }
    @if (season is not null)
    {
        <span class="reset-info" title="Prochaine réinitialisation hebdomadaire (@season.Region.ToUpperInvariant())">
            <span class="eyebrow">Réinitialisation</span>
            <strong>@Ui.Countdown(season.NextResetUtc)</strong>
        </span>
    }
    <button class="btn btn-primary btn-search" type="button" @onclick="OpenSearch" disabled="@(!ready)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" />
            <path d="m20 20-4-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        Rechercher
    </button>
</TopBar>

@if (searchOpen)
{
<div class="modal-backdrop" @onclick="CloseSearch">
<section class="modal panel search-modal" @onclick:stopPropagation @onkeydown="OnSearchKeyDown"
         role="dialog" aria-modal="true" aria-labelledby="search-title">
    <header class="modal-head">
        <div>
            <h2 id="search-title" class="title">Rechercher un personnage</h2>
            <p class="subtitle">Il rejoint ton historique et la grille de suivi.</p>
        </div>
        <button type="button" class="btn btn-ghost close" @onclick="CloseSearch" aria-label="Fermer">✕</button>
    </header>

    <form class="search-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label class="field field-region">
            <span>Région</span>
            <select value="@region" @onchange="OnRegionChangedAsync" disabled="@(!ready)">
                @foreach (var r in Regions.All)
                {
                    <option value="@r">@r.ToUpperInvariant()</option>
                }
            </select>
        </label>

        <label class="field field-realm">
            <span>Royaume</span>
            <input @bind="realm" list="realm-list" placeholder="Hyjal, Archimonde…" autocomplete="off" disabled="@(!ready)" />
            <datalist id="realm-list">
                @foreach (var r in realms)
                {
                    <option value="@r.Name"></option>
                }
            </datalist>
        </label>

        <label class="field field-name">
            <span>Personnage</span>
            <input @ref="nameInput" @bind="name" placeholder="Nom du personnage" autocomplete="off" disabled="@(!ready)" />
        </label>

        <button class="btn btn-primary" type="submit" disabled="@(!ready || searching)">
            @(searching ? "Recherche…" : "Rechercher")
        </button>
    </form>

    <div class="history-row">
        <label class="field field-history">
            <span>Historique (@history.Count)</span>
            <select value="@selectedHistoryKey" @onchange="OnHistorySelectedAsync" disabled="@(!ready || history.Count == 0)">
                <option value="">@(history.Count == 0 ? "Aucune recherche pour l'instant" : "- Choisir un personnage -")</option>
                @foreach (var h in history)
                {
                    <option value="@h.Key">@h.Label</option>
                }
            </select>
        </label>
        <button class="btn btn-ghost" type="button" @onclick="ClearHistoryAsync" disabled="@(history.Count == 0)">Vider l'historique</button>
    </div>

    @if (searchError is not null)
    {
        <p class="alert">@searchError</p>
    }
</section>
</div>
}

<main class="shell">
@if (!ready)
{
    <section class="panel empty-state"><div class="spinner"></div><p>Ouverture de l'Abîme…</p></section>
}
else if (columns.Count == 0)
{
    <section class="panel empty-state">
        <h2>Aucun personnage suivi</h2>
        <p>Lance une recherche : chaque personnage trouvé est mémorisé sur ce poste.</p>
        <button class="btn btn-primary" type="button" @onclick="OpenSearch">Rechercher un personnage</button>
    </section>
}
else
{
    <CharacterGrid Season="season"
                   Columns="SortedColumns"
                   HighlightKey="@highlightKey"
                   SortBy="@settings.SortBy"
                   OnSortChanged="OnSortChangedAsync"
                   CollapsedSections="settings.CollapsedSections"
                   OnToggleSection="ToggleSectionAsync"
                   OnRefresh="c => LoadColumnAsync(c, forceRefresh: true)"
                   OnRemove="RemoveAsync"
                   OnShowEquipment="c => equipmentFor = c.Data" />
}
</main>

@if (equipmentFor is not null)
{
    <EquipmentDialog Character="equipmentFor" OnClose="() => equipmentFor = null" />
}

@code {
    private bool ready;
    private bool searching;
    private bool searchOpen;
    private bool focusNameInput;
    private ElementReference nameInput;
    private string region = "eu";
    private string? realm;
    private string? name;
    private string? searchError;
    private string selectedHistoryKey = "";
    private string? highlightKey;

    private AltPulseSettings settings = new();
    private List<HistoryEntry> history = [];
    private readonly List<CharacterColumn> columns = [];
    private IReadOnlyList<RealmInfo> realms = [];
    private SeasonInfo? season;
    private CharacterSnapshot? equipmentFor;

    private IReadOnlyList<CharacterColumn> SortedColumns => Ui.Sort(columns, settings.SortBy).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusNameInput && searchOpen)
        {
            focusNameInput = false;
            await nameInput.FocusAsync(preventScroll: true);
        }

        if (!firstRender)
        {
            return;
        }

        // localStorage n'existe qu'une fois le circuit/WASM interactif : rien n'est lu pendant le prérendu.
        settings = await Store.GetSettingsAsync();
        history = await Store.GetHistoryAsync();
        region = Regions.All.Contains(settings.LastRegion) ? settings.LastRegion : "eu";
        columns.AddRange(history.Select(h => new CharacterColumn(h)));
        ready = true;
        if (columns.Count == 0)
        {
            OpenSearch();
        }

        StateHasChanged();

        await Task.WhenAll(LoadRegionAsync(region), LoadAllColumnsAsync());
    }

    private async Task LoadRegionAsync(string targetRegion)
    {
        var seasonTask = Api.GetSeasonAsync(targetRegion);
        var realmsTask = Api.GetRealmsAsync(targetRegion);
        try
        {
            await Task.WhenAll(seasonTask, realmsTask);
        }
        catch (Exception)
        {
            // Les tâches en échec sont gérées individuellement ci-dessous.
        }

        if (targetRegion != region)
        {
            return;
        }

        season = seasonTask.IsCompletedSuccessfully ? seasonTask.Result : season;
        realms = realmsTask.IsCompletedSuccessfully ? realmsTask.Result : [];
        StateHasChanged();
    }

    private async Task LoadAllColumnsAsync()
    {
        using var throttle = new SemaphoreSlim(4);
        await Task.WhenAll(columns.ToList().Select(async c =>
        {
            await throttle.WaitAsync();
            try
            {
                await LoadColumnAsync(c, forceRefresh: false);
            }
            finally
            {
                throttle.Release();
            }
        }));
    }

    private async Task LoadColumnAsync(CharacterColumn column, bool forceRefresh)
    {
        column.Loading = true;
        column.Error = null;
        StateHasChanged();

        try
        {
            var result = await Api.GetCharacterAsync(column.Entry.Region, column.Entry.RealmSlug, column.Entry.Name, forceRefresh);
            column.Data = result.Character ?? column.Data;
            column.Error = result.Error;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            column.Error = "Serveur injoignable.";
        }
        finally
        {
            column.Loading = false;
            StateHasChanged();
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(realm) || string.IsNullOrWhiteSpace(name))
        {
            searchError = "Indique un royaume et un nom de personnage.";
            return;
        }

        var realmSlug = realms.FirstOrDefault(r => string.Equals(r.Name, realm.Trim(), StringComparison.OrdinalIgnoreCase))?.Slug ?? realm.Trim();
        await SearchCoreAsync(realmSlug);
    }

    private async Task SearchCoreAsync(string realmSlug)
    {
        searching = true;
        searchError = null;

        try
        {
            var result = await Api.GetCharacterAsync(region, realmSlug, name!.Trim());
            if (result.Character is not { } character)
            {
                searchError = result.Error ?? "Personnage introuvable.";
                return;
            }

            history = await Store.AddOrTouchAsync(character);
            var entry = history[0];
            var column = columns.FirstOrDefault(c => c.Key == character.Key);
            if (column is null)
            {
                column = new CharacterColumn(entry);
                columns.Add(column);
            }

            column.Entry = entry;
            column.Data = character;
            column.Error = null;
            selectedHistoryKey = character.Key;
            searchOpen = false;
            await HighlightAsync(character.Key);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            searchError = "Impossible de joindre le serveur.";
        }
        finally
        {
            searching = false;
        }
    }

    private void OpenSearch()
    {
        searchOpen = true;
        searchError = null;
        focusNameInput = true;
    }

    private void CloseSearch() => searchOpen = false;

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseSearch();
        }
    }

    private async Task OnHistorySelectedAsync(ChangeEventArgs e)
    {
        selectedHistoryKey = e.Value?.ToString() ?? "";
        if (history.FirstOrDefault(h => h.Key == selectedHistoryKey) is not { } entry)
        {
            return;
        }

        name = entry.Name;
        realm = entry.RealmName;
        if (region != entry.Region)
        {
            region = entry.Region;
            await LoadRegionAsync(region);
        }

        await SearchCoreAsync(entry.RealmSlug);
    }

    private async Task OnRegionChangedAsync(ChangeEventArgs e)
    {
        region = e.Value?.ToString() ?? "eu";
        settings = settings with { LastRegion = region };
        await Store.SaveSettingsAsync(settings);
        await LoadRegionAsync(region);
    }

    private async Task OnSortChangedAsync(string sortBy)
    {
        settings = settings with { SortBy = sortBy };
        await Store.SaveSettingsAsync(settings);
    }

    private async Task ToggleSectionAsync(string section)
    {
        if (!settings.CollapsedSections.Remove(section))
        {
            settings.CollapsedSections.Add(section);
        }

        await Store.SaveSettingsAsync(settings);
    }

    private async Task RemoveAsync(CharacterColumn column)
    {
        columns.Remove(column);
        history = await Store.RemoveAsync(column.Key);
        if (selectedHistoryKey == column.Key)
        {
            selectedHistoryKey = "";
        }
    }

    private async Task ClearHistoryAsync()
    {
        await Store.ClearAsync();
        history.Clear();
        columns.Clear();
        selectedHistoryKey = "";
    }

    private async Task HighlightAsync(string key)
    {
        highlightKey = key;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("altpulse.scrollToColumn", key);
    }
}
