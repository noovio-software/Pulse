@* Icônes au trait (24×24, currentColor) des libellés de la grille, visibles seules quand la colonne est réduite. *@

<svg class="grid-icon" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "users":
            <circle cx="9" cy="8" r="4" />
            <path d="M2 21a7 7 0 0 1 14 0M17 4a4 4 0 0 1 0 8M22 21a7 7 0 0 0-5-6.7" />
            break;
        case "sort":
            <path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4" />
            break;
        case "collapse":
            <path d="M15 18l-6-6 6-6" />
            break;
        case "level":
            <path d="M12 19V5M5 12l7-7 7 7" />
            break;
        case "ilvl":
            <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" />
            break;
        case "rating":
            <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" />
            <path d="M10.8 12.2L19 4M16 7l3 3M14 9l2 2" />
            break;
        case "raid":
            <path d="M3 8l4 4 5-7 5 7 4-4-2 11H5z" />
            break;
        case "dungeon":
            <path d="M5 21V10a7 7 0 0 1 14 0v11M3 21h18M12 21v-6" />
            break;
        case "world":
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
            break;
        case "history":
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2" />
            break;
        case "progress":
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
    }
</svg>
