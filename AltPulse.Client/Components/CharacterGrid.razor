@* Grille de suivi : une colonne par personnage, une ligne par information. *@

<div class="grid-wrap panel">
    <table class="track-grid @(Compact ? "is-compact" : "")">
        <thead>
            <tr>
                <th class="label-col corner">
                    <div class="corner-head">
                        <span class="corner-count" title="@Columns.Count personnage(s) suivi(s)">
                            <span class="label-icon"><GridIcon Name="users" /></span>
                            <span class="label-text eyebrow">Personnages</span>
                            <strong>@Columns.Count</strong>
                        </span>
                        <button type="button" class="compact-toggle" @onclick="OnToggleCompact"
                                title="@(Compact ? "Déplier la colonne" : "Réduire la colonne aux icônes")"
                                aria-label="@(Compact ? "Déplier la colonne" : "Réduire la colonne aux icônes")"
                                aria-expanded="@(!Compact)">
                            <GridIcon Name="collapse" Size="16" />
                        </button>
                    </div>
                    <label class="sort" title="Trier par : @SortLabel">
                        <span class="label-icon sort-icon"><GridIcon Name="sort" /></span>
                        <span class="label-text eyebrow">Trier par</span>
                        @* En mode réduit, le select est posé invisible sur l'icône : un tap ouvre la liste native. *@
                        <select value="@SortBy" @onchange="OnSortSelected" aria-label="Trier par">
                            @foreach (var (value, label) in Ui.SortOptions)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </label>
                </th>
                @foreach (var col in Columns)
                {
                    var c = col.Data;
                    <th class="char-head @(col.Key == HighlightKey ? "is-highlight" : "") @Ui.ClassCss(c?.ClassId ?? col.Entry.ClassId)" data-character-key="@col.Key">
                        <div class="char-card">
                            <div class="avatar">
                                @if (c?.AvatarUrl is not null)
                                {
                                    <img src="@c.AvatarUrl" alt="" loading="lazy" />
                                }
                                @if (col.Loading)
                                {
                                    <span class="spinner small"></span>
                                }
                            </div>
                            <a class="char-name" href="@(c?.ArmoryUrl ?? "#")" target="_blank" rel="noopener">@(c?.Name ?? col.Entry.Name)</a>
                            <span class="char-realm">@(c?.RealmName ?? col.Entry.RealmName) · @col.Entry.Region.ToUpperInvariant()</span>
                            @if (c is not null)
                            {
                                <span class="char-spec">@c.SpecName @c.ClassName</span>
                                @if (c.GuildName is not null)
                                {
                                    <span class="char-guild">&lt;@c.GuildName&gt;</span>
                                }
                            }
                            <div class="char-actions">
                                <button type="button" title="Rafraîchir (ignore le cache)" @onclick="() => OnRefresh.InvokeAsync(col)" disabled="@col.Loading">↻</button>
                                <button type="button" title="Équipement" @onclick="() => OnShowEquipment.InvokeAsync(col)" disabled="@(c is null)">⚔</button>
                                @if (c?.RaiderIoUrl is not null)
                                {
                                    <a title="Profil Raider.io" href="@c.RaiderIoUrl" target="_blank" rel="noopener">R</a>
                                }
                                <button type="button" title="Retirer de l'historique" class="danger" @onclick="() => OnRemove.InvokeAsync(col)">✕</button>
                            </div>
                            @if (col.Error is not null)
                            {
                                <span class="char-error">@col.Error</span>
                            }
                            else if (c is { Warnings.Count: > 0 })
                            {
                                <span class="char-warning" title="@string.Join("\n", c.Warnings)">⚠ données partielles</span>
                            }
                        </div>
                    </th>
                }
            </tr>
        </thead>

        <tbody>
            @* ───────── Résumé ───────── *@
            <SectionHeaderRow Id="summary" Title="Personnage" ColumnCount="@(Columns.Count + 1)" CollapsedSections="CollapsedSections" OnToggle="OnToggleSection" />
            @if (!IsCollapsed("summary"))
            {
                <tr>
                    <th class="label-col" title="Niveau"><GridLabel Icon="level" Text="Niveau" /></th>
                    @foreach (var col in Columns)
                    {
                        <td>
                            @if (col.Data is { } c)
                            {
                                @(c.Level > 0 ? c.Level.ToString() : "-")
                            }
                            else
                            {
                                <CellPlaceholder Loading="col.Loading" />
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="label-col" title="Niveau d'objet"><GridLabel Icon="ilvl" Text="Niveau d'objet" /></th>
                    @foreach (var col in Columns)
                    {
                        <td class="ilvl">
                            @if (col.Data is { } c)
                            {
                                <strong>@Ui.Ilvl(c.ItemLevelEquipped)</strong>
                                @if (c.ItemLevelAverage is { } avg && avg > (c.ItemLevelEquipped ?? 0))
                                {
                                    <small title="Niveau d'objet moyen (sacs inclus)"> / @Ui.Ilvl(avg)</small>
                                }
                            }
                            else
                            {
                                <CellPlaceholder Loading="col.Loading" />
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="label-col" title="Score Mythique+"><GridLabel Icon="rating" Text="Score Mythique+" /></th>
                    @foreach (var col in Columns)
                    {
                        <td>
                            @if (col.Data is { } c)
                            {
                                <strong class="rating" style="color:@(c.RatingColor ?? "inherit")">@Ui.Rating(c.Rating)</strong>
                            }
                            else
                            {
                                <CellPlaceholder Loading="col.Loading" />
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th class="label-col" title="Clés cette semaine"><GridLabel Icon="key" Text="Clés cette semaine" /></th>
                    @foreach (var col in Columns)
                    {
                        <td>
                            @if (col.Data is { } c)
                            {
                                @if (c.WeeklyRuns.Count == 0)
                                {
                                    <span class="muted">Aucune</span>
                                }
                                else
                                {
                                    <span title="@string.Join("\n", c.WeeklyRuns.Select(r => $"+{r.Level} {r.Dungeon} {Ui.Stars(r.Upgrades)}"))">
                                        @(c.WeeklyRuns.Count >= 10 ? "10+" : c.WeeklyRuns.Count.ToString()) · max <strong>+@c.WeeklyRuns[0].Level</strong>
                                    </span>
                                }
                            }
                            else
                            {
                                <CellPlaceholder Loading="col.Loading" />
                            }
                        </td>
                    }
                </tr>
            }

            @* ───────── Grande Chambre forte ───────── *@
            <SectionHeaderRow Id="vault" Title="Grande Chambre forte" ColumnCount="@(Columns.Count + 1)" CollapsedSections="CollapsedSections" OnToggle="OnToggleSection" />
            @if (!IsCollapsed("vault"))
            {
                <VaultRow Icon="raid" Label="Raids" Columns="Columns" Slots="RaidSlots" Unit="boss" />
                <VaultRow Icon="dungeon" Label="Donjons" Columns="Columns" Slots="DungeonSlots" Unit="clé" />
                <tr>
                    <th class="label-col" title="Monde : les activités Monde / Gouffres ne sont pas exposées par les API publiques."><GridLabel Icon="world" Text="Monde" /></th>
                    @foreach (var col in Columns)
                    {
                        <td><span class="muted" title="Non disponible via les API Blizzard / Raider.io">n/d</span></td>
                    }
                </tr>
                <VaultRow Icon="history" Label="Semaine passée (M+)" Columns="Columns" Slots="PreviousWeekSlots" Unit="clé" Previous="true" />
            }

            @* ───────── Mythique+ ───────── *@
            @if (Season is not null)
            {
                <SectionHeaderRow Id="dungeons" Title="@DungeonsTitle" ColumnCount="@(Columns.Count + 1)" CollapsedSections="CollapsedSections" OnToggle="OnToggleSection" />
                @if (!IsCollapsed("dungeons"))
                {
                    @foreach (var dungeon in Season.Dungeons)
                    {
                        <tr>
                            <th class="label-col dungeon-label" title="@dungeon.Name - chrono @Ui.Duration(dungeon.TimerSeconds * 1000L)">
                                @if (dungeon.IconUrl is not null)
                                {
                                    <img src="@dungeon.IconUrl" alt="" loading="lazy" />
                                }
                                <span class="dungeon-name">@dungeon.Name</span>
                                <span class="dungeon-short">@dungeon.ShortName</span>
                            </th>
                            @foreach (var col in Columns)
                            {
                                var best = col.Data?.DungeonBests.FirstOrDefault(b => b.DungeonSlug == dungeon.Slug);
                                <td>
                                    @if (col.Data is null)
                                    {
                                        <CellPlaceholder Loading="col.Loading" />
                                    }
                                    else if (best is null)
                                    {
                                        <span class="muted">-</span>
                                    }
                                    else
                                    {
                                        <a class="run @Ui.RunCss(best.Upgrades)" href="@best.Url" target="_blank" rel="noopener"
                                           title="@($"+{best.Level} en {Ui.Duration(best.ClearTimeMs)} / {Ui.Duration(best.ParTimeMs)} · {best.Score:0.#} pts")">
                                            +@best.Level<span class="stars">@Ui.Stars(best.Upgrades)</span>
                                        </a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }

                @* ───────── Raids ───────── *@
                @foreach (var raid in Season.Raids)
                {
                    var sectionId = $"raid:{raid.Slug}";
                    <SectionHeaderRow Id="@sectionId" Title="@raid.Name" ColumnCount="@(Columns.Count + 1)" CollapsedSections="CollapsedSections" OnToggle="OnToggleSection" />
                    @if (!IsCollapsed(sectionId))
                    {
                        <tr>
                            <th class="label-col" title="Progression"><GridLabel Icon="progress" Text="Progression" /></th>
                            @foreach (var col in Columns)
                            {
                                var lockout = col.Data?.Raids.FirstOrDefault(r => r.RaidSlug == raid.Slug);
                                <td>
                                    @if (col.Data is null)
                                    {
                                        <CellPlaceholder Loading="col.Loading" />
                                    }
                                    else
                                    {
                                        <span class="raid-summary">@(lockout?.Summary ?? "-")</span>
                                    }
                                </td>
                            }
                        </tr>
                        @foreach (var (difficulty, label, shortLabel) in Ui.Difficulties)
                        {
                            <tr class="lockout-row">
                                <th class="label-col" title="@label"><span class="diff diff-@shortLabel.ToLowerInvariant()">@shortLabel</span> <span class="label-text">@label</span></th>
                                @foreach (var col in Columns)
                                {
                                    var kills = col.Data?.Raids.FirstOrDefault(r => r.RaidSlug == raid.Slug)?.KilledThisWeek.GetValueOrDefault(difficulty);
                                    <td>
                                        @if (kills is null)
                                        {
                                            @if (col.Data is null)
                                            {
                                                <CellPlaceholder Loading="col.Loading" />
                                            }
                                            else
                                            {
                                                <span class="muted">-</span>
                                            }
                                        }
                                        else
                                        {
                                            var count = kills.Count(k => k);
                                            <div class="bosses @(count == 0 ? "is-empty" : "")" title="@BossTooltip(raid, kills)">
                                                @for (var i = 0; i < kills.Length; i++)
                                                {
                                                    <span class="boss @(kills[i] ? "killed" : "") diff-@shortLabel.ToLowerInvariant()"></span>
                                                }
                                                <small>@count/@kills.Length</small>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                }
            }

            <tr class="footer-row">
                <th class="label-col" title="Mis à jour"><GridLabel Icon="clock" Text="Mis à jour" /></th>
                @foreach (var col in Columns)
                {
                    <td><small class="muted">@(col.Data is { } c ? Ui.Ago(c.FetchedAtUtc) : "-")</small></td>
                }
            </tr>
        </tbody>
    </table>
</div>
