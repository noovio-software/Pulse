@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using PulseAdmin.Notifications
@inject IOptions<NotificationOptions> Notifications

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/">
            <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path d="M2 17h7l3-8 5 15 4-11 2 4h7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>PulseMetrics Admin</span>
        </a>
        <nav class="nav">
            <NavLink href="/" Match="NavLinkMatch.All">Tableau de bord</NavLink>
            <NavLink href="/benchs">Benchs</NavLink>
        </nav>
        @* Pilotés par app.js : cachés tant que le navigateur ne les permet pas. *@
        <div class="topbar-actions">
            <button type="button" class="btn btn-ghost btn-small" id="install-app" hidden title="Installer PulseMetrics Admin comme une application">Installer l'app</button>
            @if (Notifications.Value.IsConfigured)
            {
                <button type="button" class="btn btn-ghost btn-small" id="push-toggle" hidden data-vapid-key="@Notifications.Value.PublicKey"
                        data-times="@Notifications.Value.TimesLabel">Notifications</button>
                <button type="button" class="btn btn-ghost btn-small" id="push-test" hidden title="Envoyer le récap du jour à cet appareil">Tester</button>
            }
        </div>
        <AuthorizeView>
            <Authorized>
                <span class="who">@context.User.Identity?.Name</span>
                <a class="btn btn-ghost" href="/deconnexion">Déconnexion</a>
            </Authorized>
            <NotAuthorized>
                <span class="who">Accès local (développement)</span>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

<main class="page">
    @Body
</main>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<footer class="footer">PulseMetrics Admin v@(AppVersion) · statistiques d'usage de Front, Life et Burst · réservé, non référencé</footer>

@code {
    private static readonly string AppVersion =
        string.Join('.', (typeof(MainLayout).Assembly.GetName().Version?.ToString() ?? "0.0.0").Split('.').Take(3));
}
