[Unit]
Description=PulseAdmin by Noovio - statistiques d'usage (Kestrel)
After=network.target postgresql.service

[Service]
WorkingDirectory=/home/ubuntu/projects/pulseadmin
ExecStart=/usr/bin/dotnet /home/ubuntu/projects/pulseadmin/PulseAdmin.dll --urls http://127.0.0.1:8560
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=pulseadmin
User=ubuntu
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=true
# Secrets hors de l'unité (lisible par tous) : fichier root:root 600.
EnvironmentFile=/etc/pulseadmin/pulseadmin.env

[Install]
WantedBy=multi-user.target
