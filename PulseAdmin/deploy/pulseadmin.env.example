# Copie dans /etc/pulseadmin/pulseadmin.env (root:root 600), chargée par l'unité systemd (EnvironmentFile=).
# Pas de guillemets : systemd lit les valeurs telles quelles. Les « __ » remplacent les « : » de la configuration .NET.

# Base d'usage commune : la même chaîne est ajoutée aux fichiers d'environnement de FrontPulse, LifePulse et BurstPulse.
ConnectionStrings__PulseUsage=Host=localhost;Port=5432;Database=pulseusage;Username=pulseusage;Password=CHANGE_ME

# Connexion Battle.net : le client d'un des sites convient, en y déclarant https://pulseadmin.noovio.fr/signin-battlenet.
Blizzard__ClientId=CHANGE_ME
Blizzard__ClientSecret=CHANGE_ME

# Seuls ces BattleTags entrent, un par index à partir de 0.
Admin__BattleTags__0=CHANGE_ME#1234

# Clés de chiffrement du cookie de connexion : sans elles, chaque déploiement déconnecte.
DataProtection__KeysPath=/var/lib/pulseadmin/keys
