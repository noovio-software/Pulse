# Copie dans /etc/pulseadmin/pulseadmin.env (root:root 600), chargée par l'unité systemd.
# setup-server.sh remplace cette ligne par la connexion copiée depuis /etc/pulsemetrics/pulsemetrics.env.
ConnectionStrings__PulseUsage=Host=localhost;Port=5432;Database=pulsemetrics;Username=pulsemetrics;Password=CHANGE_ME;Search Path=usage,public

# Connexion Battle.net : déclarer https://admin.pulsemetrics.fr/signin-battlenet.
Blizzard__ClientId=CHANGE_ME
Blizzard__ClientSecret=CHANGE_ME

Admin__BattleTags__0=CHANGE_ME#1234
DataProtection__KeysPath=/var/lib/pulseadmin/keys

# Notifications push (récaps à 7h, 12h, 18h, 21h). Paire de clés VAPID générée par setup-server.sh,
# ou à la main : /home/ubuntu/projects/pulseadmin/PulseAdmin --vapid-keys
Notifications__PublicKey=
Notifications__PrivateKey=

# Jeton du bot Discord pour /api/usage/summary (même valeur que PULSEADMIN_API_KEY dans /etc/nooviobot/nooviobot.env).
# Généré par setup-server.sh.
Api__Key=
