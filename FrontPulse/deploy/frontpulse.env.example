# Copie dans /etc/frontpulse/frontpulse.env (root:root 600), chargée par les deux unités systemd (EnvironmentFile=).
# Pas de guillemets : systemd lit les valeurs telles quelles. Les « __ » remplacent les « : » de la configuration .NET.

ConnectionStrings__FrontPulse=Host=localhost;Port=5432;Database=frontpulse;Username=frontpulse;Password=CHANGE_ME

# Base d'usage commune (benchs), lue par PulseAdmin ; écrite par PulseAdmin/deploy/setup-server.sh. Sans elle, rien n'est enregistré.
#ConnectionStrings__PulseUsage=Host=localhost;Port=5432;Database=pulseusage;Username=pulseusage;Password=CHANGE_ME

# Optionnel : sans Redis, le cache (jeton Blizzard, icônes, classement) reste en mémoire de chaque processus.
#ConnectionStrings__Redis=localhost:6379

Blizzard__ClientId=CHANGE_ME
Blizzard__ClientSecret=CHANGE_ME

# Compte Keystone.guru (routes de donjons, lues par le worker). Sans lui, les pages de routes restent vides.
KeystoneGuru__Email=CHANGE_ME
KeystoneGuru__Password=CHANGE_ME

# Clés de chiffrement du cookie de connexion : sans elles, chaque déploiement déconnecte tout le monde.
DataProtection__KeysPath=/var/lib/frontpulse/keys

# Ingestion forcée en ligne de commande (en-tête X-Admin-Key) ; générée par setup-server.sh.
# BattleTags admin (page /admin/ingestion), aucun par défaut : un par index à partir de 0.
#Admin__BattleTags__0=Pseudo#1234
Admin__ApiKey=CHANGE_ME
