@page "/specs/{Slug}"
@rendermode InteractiveServer

<PageTitle>@(info is null ? "Spécialisation inconnue" : $"{info.SpecName} {info.ClassName}") · FrontPulse by Noovio</PageTitle>

<TopBar Active="info?.Spec" />

<main class="shell" style="--class-color: @(info?.Color ?? "var(--text)")">
@if (info is null)
{
    <section class="panel empty-state">
        <h1>Spécialisation inconnue</h1>
        <p>FrontPulse ne suit que les six spécialisations tank.</p>
        <a class="btn" href="/">Retour</a>
    </section>
}
else if (Meta is null)
{
    <section class="panel empty-state">
        <h1>@info.SpecName <span class="muted">@info.ClassName</span></h1>
        <p>Pas encore de données : la prochaine ingestion (toutes les 6 h) remplira cette page.</p>
    </section>
}
else
{
    <section class="panel spec-hero">
        <div class="spec-identity">
            <img class="wow-icon spec-icon" src="@info.IconUrl" alt="" width="64" height="64" />
            <div class="spec-title">
                <span class="eyebrow">@info.ClassName</span>
                <h1>@info.SpecName</h1>
            </div>
            <CompareButton Spec="info" />
        </div>

        <dl class="hero-facts">
            <div><dt>Échantillon</dt><dd>@Meta.SampleSize <small>tanks</small></dd></div>
            <div><dt>Niv. d'objet médian</dt><dd>@Ui.Ilvl(Meta.MedianItemLevel)</dd></div>
            <div><dt>Clé médiane</dt><dd>+@Meta.MedianKeyLevel</dd></div>
            @if (Meta.HeroTrees.FirstOrDefault() is { } hero)
            {
                <div>
                    <dt>Arbre héroïque</dt>
                    <dd class="hero-fact">
                        @if (Ui.HeroIcon(Meta.TalentTree, hero.Name) is { } heroIcon)
                        {
                            <img class="wow-icon" src="@heroIcon" alt="" width="22" height="22" />
                        }
                        @hero.Name <small>@Ui.Percent(hero.Share)</small>
                    </dd>
                </div>
            }
            <div><dt>Mise à jour</dt><dd title="@Meta.ComputedAtUtc.ToLocalTime().ToString("g")">@Ui.Ago(Meta.ComputedAtUtc)</dd></div>
        </dl>
    </section>

    <div class="meta-columns">
        <section class="panel meta-section">
            <h2 class="section-title">Caractéristiques secondaires</h2>
            <StatGauges Stats="Meta.Stats" />
        </section>

        <section class="panel meta-section">
            <h2 class="section-title">Talents</h2>
            <TalentBuildPanel Spec="info" Builds="Meta.TalentBuilds" HeroTrees="Meta.HeroTrees" Layout="Meta.TalentTree" SampleSize="Meta.SampleSize" />
        </section>
    </div>

    <section class="panel meta-section">
        <h2 class="section-title">Équipement <small class="muted">part du top portant chaque objet</small></h2>
        <GearSlotGrid Slots="GearSlots" />
    </section>

    <div class="meta-columns">
        <section class="panel meta-section">
            <h2 class="section-title">Bijoux</h2>
            <div class="trinket-columns">
                <div>
                    <h3 class="trinket-head is-defensive">Défensifs</h3>
                    @foreach (var item in Meta.DefensiveTrinkets)
                    {
                        <ItemUsage Item="item" />
                    }
                    @if (Meta.DefensiveTrinkets.Count == 0)
                    {
                        <p class="muted">Aucun bijou défensif dans le top : les deux emplacements servent aux dégâts.</p>
                    }
                </div>
                <div>
                    <h3 class="trinket-head is-offensive">Offensifs</h3>
                    @foreach (var item in Meta.OffensiveTrinkets)
                    {
                        <ItemUsage Item="item" />
                    }
                    @if (Meta.OffensiveTrinkets.Count == 0)
                    {
                        <p class="muted">Aucun bijou offensif dans le top.</p>
                    }
                </div>
            </div>
        </section>

        <section class="panel meta-section">
            <h2 class="section-title">Embellissements</h2>
            @if (Meta.Embellishments.Count == 0)
            {
                <p class="muted">Aucun embellissement relevé.</p>
            }
            else
            {
                <ol class="embellishments">
                    @foreach (var combo in Meta.Embellishments)
                    {
                        <li>
                            <span class="combo-names">
                                @* Parts vaut null dans un snapshot écrit avant l'ajout des icônes. *@
                                @foreach (var part in combo.Parts ?? [])
                                {
                                    <a class="combo-chip" href="@(part.SpellId > 0 ? Ui.SpellUrl(part.SpellId) : $"https://www.wowhead.com/fr/item={part.ItemId}")"
                                       data-wowhead="@(part.SpellId > 0 ? Ui.SpellWowhead(part.SpellId) : $"item={part.ItemId}&domain=fr")"
                                       target="_blank" rel="noopener">
                                        @if (part.IconUrl is not null)
                                        {
                                            <img class="wow-icon" src="@part.IconUrl" alt="" loading="lazy" />
                                        }
                                        @part.Name
                                        @if (part.Count > 1)
                                        {
                                            <span class="combo-count">×@part.Count</span>
                                        }
                                    </a>
                                }
                            </span>
                            <strong>@Ui.Percent(combo.Share)</strong>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

    <section class="panel meta-section">
        <h2 class="section-title">Les @Meta.Players.Count meilleurs tanks <small class="muted">classés sur leur meilleure clé de la saison</small></h2>
        <div class="players-head" aria-hidden="true">
            <span>#</span><span>Joueur</span><span>Clé</span><span>Score</span><span>Niv.</span>
        </div>
        <div class="players" tabindex="0">
            <Virtualize Items="players" Context="p" ItemSize="38" OverscanCount="8">
                <div class="player-row">
                    <span class="player-rank">@p.Rank</span>
                    <span class="player-name">
                        @if (p.ProfileUrl is not null)
                        {
                            <a href="@p.ProfileUrl" target="_blank" rel="noopener">@p.Name</a>
                        }
                        else
                        {
                            @p.Name
                        }
                        <small>@p.Region.ToUpperInvariant() · @p.RealmSlug</small>
                    </span>
                    <span class="player-key">+@p.BestKeyLevel</span>
                    <span>@p.BestRunScore.ToString("0.0")</span>
                    <span>@Ui.Ilvl(p.ItemLevel)</span>
                </div>
            </Virtualize>
        </div>
    </section>

    <CompareCallout Spec="info" />
}
</main>
