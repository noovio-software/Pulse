@page "/admin/ingestion"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Ingestion · Admin · FrontPulse by Noovio</PageTitle>

<TopBar />

<main class="shell">
@if (!isAdmin)
{
    <section class="panel empty-state">
        <h1>Accès réservé</h1>
        <p>Cette page est réservée aux administrateurs de FrontPulse.</p>
        <a class="btn" href="/">Retour</a>
    </section>
}
else
{
    <section class="panel admin-head">
        <div>
            <span class="eyebrow">Administration</span>
            <h1>Ingestion des données</h1>
            <p class="muted">
                Classement Raider.io, profils Blizzard puis recalcul de la méta des six spécialisations (environ 30 min).
                Le worker relève la demande sous 30 s ; elle s'ajoute aux exécutions automatiques toutes les 6 h.
            </p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="RequestAsync" disabled="@(busy || HasActive)">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 1-15.5 6.2L3 16M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M3 21v-5h5" />
            </svg>
            @(HasActive ? "Ingestion en attente ou en cours" : "Lancer une ingestion")
        </button>
    </section>

    @if (notice is not null)
    {
        <p class="admin-notice">@notice</p>
    }

    <section class="panel meta-section">
        <h2 class="section-title">Dernières demandes <small class="muted">actualisé toutes les 15 s</small></h2>
        @if (recent.Count == 0)
        {
            <p class="muted">Aucune demande pour l'instant : seules les exécutions automatiques ont tourné.</p>
        }
        else
        {
            <ul class="runs">
                @foreach (var r in recent)
                {
                    <li class="run status-@r.Status.ToString().ToLowerInvariant()">
                        <span class="run-status">@StatusLabel(r.Status)</span>
                        <div class="run-text">
                            <strong>Demandée @Ui.Ago(r.RequestedAtUtc) par @r.RequestedBy</strong>
                            <span class="muted">
                                @if (r.StartedAtUtc is { } started)
                                {
                                    <text>Démarrée @Ui.Ago(started)</text>
                                }
                                @if (r.CompletedAtUtc is { } done)
                                {
                                    <text> · terminée @Ui.Ago(done)</text>
                                }
                            </span>
                            @if (r.Message is not null)
                            {
                                <span class="run-message">@r.Message</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel meta-section">
        <h2 class="section-title">En ligne de commande</h2>
        <pre class="admin-cmd">curl -X POST https://frontpulse.noovio.fr/api/admin/ingestion -H "X-Admin-Key: &lt;clé&gt;"
curl https://frontpulse.noovio.fr/api/admin/ingestion -H "X-Admin-Key: &lt;clé&gt;"</pre>
        <p class="muted">La clé est <code>Admin__ApiKey</code> dans <code>/etc/frontpulse/frontpulse.env</code> sur le serveur.</p>
    </section>
}
</main>
