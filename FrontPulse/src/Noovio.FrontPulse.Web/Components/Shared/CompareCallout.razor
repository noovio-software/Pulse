@* Encart d'appel à la comparaison : ce que l'analyse d'un personnage apporte, et le bouton qui y mène. *@

<section class="panel compare-callout" style="@(Spec is null ? null : $"--class-color: {Spec.Color}")">
    <div class="compare-visual" aria-hidden="true">
        @if (Spec is not null)
        {
            <img class="wow-icon" src="@Spec.IconUrl" alt="" width="44" height="44" />
        }
        else
        {
            <span class="compare-visual-me">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
                </svg>
            </span>
        }
        <span class="compare-vs">VS</span>
        <span class="compare-visual-top">Top<br /><strong>100</strong></span>
    </div>

    <div class="compare-text">
        <h2>@(Spec is null ? "Compare ton tank au top 100" : $"Ton {Spec.SpecName} face au top 100")</h2>
        <p>
            Score sur 100, plan d'action, et l'écart avec la méta sur l'équipement, les caractéristiques, les talents,
            les bijoux et le Mythique+.
            <AuthorizeView>
                <NotAuthorized><span class="compare-hint">Connexion Battle.net : seuls tes personnages sont lus.</span></NotAuthorized>
            </AuthorizeView>
        </p>
    </div>

    <CompareButton Spec="Spec" />
</section>
