@* Un constat de l'analyse : quoi (titre), l'action à faire, puis sa raison en plus discret. *@

<article class="finding @Ui.VerdictCss(Finding.Verdict)">
    <VerdictIcon Verdict="Finding.Verdict" Size="20" />
    <div class="finding-body">
        <header>
            @if (Finding.IconUrl is not null)
            {
                <img class="wow-icon" src="@Finding.IconUrl" alt="" width="22" height="22" />
            }
            <strong>@Finding.Title</strong>
            <span class="finding-area">@Ui.AreaLabel(Finding.Area)</span>
        </header>
        <p class="finding-how">@Finding.How</p>
        <p class="finding-why">@Finding.Why</p>
    </div>
</article>
