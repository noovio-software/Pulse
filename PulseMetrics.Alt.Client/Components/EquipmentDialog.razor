
<div class="modal-backdrop" @onclick="OnClose">
    <div class="modal panel @Ui.ClassCss(Character.ClassId)" @onclick:stopPropagation role="dialog" aria-modal="true" aria-label="@AltLocalization.F(AltTexts.Equipment_Aria, Character.Name)">
        <header class="modal-head">
            @if ((Character.InsetUrl ?? Character.AvatarUrl) is { } img)
            {
                <img class="modal-portrait" src="@img" alt="" />
            }
            <div>
                <h2 class="char-name">@Character.Name</h2>
                <p class="muted">@Character.SpecName @Character.ClassName · @Character.RealmName</p>
                <p>@AltTexts.Equipment_Ilvl <strong>@Ui.Ilvl(Character.ItemLevelEquipped)</strong></p>
            </div>
            <button type="button" class="btn btn-ghost close" @onclick="OnClose" aria-label="@AltTexts.Common_Close">✕</button>
        </header>

        @if (Character.Equipment.Count == 0)
        {
            <p class="muted">@AltTexts.Equipment_None</p>
        }
        else
        {
            <ul class="gear">
                @foreach (var item in Character.Equipment)
                {
                    <li>
                        <span class="gear-icon @Ui.QualityCss(item.Quality)">
                            @if (item.IconUrl is not null)
                            {
                                <img src="@item.IconUrl" alt="" loading="lazy" />
                            }
                        </span>
                        <span class="gear-ilvl">@item.ItemLevel</span>
                        <div class="gear-text">
                            <small class="muted">@Ui.SlotName(item)</small>
                            <a class="@Ui.QualityCss(item.Quality)" href="@Ui.ItemUrl(item)" data-wowhead="@Ui.WowheadData(item)" target="_blank" rel="noopener">@item.Name</a>
                            @foreach (var enchant in item.Enchantments)
                            {
                                <small class="enchant">@enchant</small>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
