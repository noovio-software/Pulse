<Project>

  <!-- Réglages communs à PulseCore et aux applications qui en dépendent (importés par leur Directory.Build.props). Même cible que AltPulse (même SDK, même VPS). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Les ressources neutres (.resx sans suffixe) sont en français ; l'anglais vit dans les .en.resx. -->
    <NeutralLanguage>fr</NeutralLanguage>

    <!-- Version d'EF Core et des extensions : les applications doivent rester alignées sur PulseCore. -->
    <PulseExtensionsVersion>11.0.0</PulseExtensionsVersion>
  </PropertyGroup>

</Project>
