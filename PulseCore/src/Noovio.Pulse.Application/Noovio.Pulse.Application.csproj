<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Noovio.Pulse.Domain\Noovio.Pulse.Domain.csproj" />
  </ItemGroup>

  <!-- Textes de l'analyse et de l'import : français (neutre) et anglais. La classe d'accès est générée à la compilation. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\AnalysisTexts.resx" StronglyTypedLanguage="CSharp" StronglyTypedClassName="AnalysisTexts" StronglyTypedNamespace="Noovio.Pulse.Application.Resources" StronglyTypedFileName="$(IntermediateOutputPath)AnalysisTexts.Designer.cs" />
    <!-- Les tests vérifient que chaque texte existe dans les deux langues. -->
    <InternalsVisibleTo Include="Noovio.Pulse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(PulseExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(PulseExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(PulseExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(PulseExtensionsVersion)" />
  </ItemGroup>

</Project>
