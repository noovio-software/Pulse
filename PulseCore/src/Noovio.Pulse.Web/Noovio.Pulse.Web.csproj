<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Le site commun (pages, composants, connexion Battle.net, socle CSS) : chaque application n'apporte que son hôte et son thème. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Les usings implicites du SDK Web : la RCL n'en hérite pas. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Textes de l'interface : français (neutre) et anglais. La classe d'accès WebTexts.Designer.cs est versionnée
       à côté du .resx pour que l'IDE la voie ; Rider / Visual Studio la régénèrent quand on enregistre le .resx. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\WebTexts.resx" Generator="ResXFileCodeGenerator" LastGenOutput="WebTexts.Designer.cs" />
    <Compile Update="Resources\WebTexts.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="WebTexts.resx" />
    <!-- Les tests vérifient que chaque texte existe dans les deux langues. -->
    <InternalsVisibleTo Include="Noovio.Pulse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noovio.Pulse.Infrastructure\Noovio.Pulse.Infrastructure.csproj" />
    <ProjectReference Include="..\Noovio.Pulse.Usage\Noovio.Pulse.Usage.csproj" />
  </ItemGroup>

  <!-- Vignette des liens partagés : SkiaSharp dessine l'image ; la variante Linux « NoDependencies » n'exige ni fontconfig
       ni police système sur le serveur, les polices du site (OFL, licences à côté) étant embarquées. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ShareCard\Fonts\*.ttf" LogicalName="ShareCard.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
