<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Le site commun (pages, composants, connexion Battle.net, socle CSS) : chaque application n'apporte que son hôte et son thème. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Les usings implicites du SDK Web : la RCL n'en hérite pas. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Textes de l'interface : français (neutre) et anglais. La classe d'accès est générée à la compilation. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\WebTexts.resx" StronglyTypedLanguage="CSharp" StronglyTypedClassName="WebTexts" StronglyTypedNamespace="Noovio.Pulse.Web.Resources" StronglyTypedFileName="$(IntermediateOutputPath)WebTexts.Designer.cs" />
    <!-- Les tests vérifient que chaque texte existe dans les deux langues. -->
    <InternalsVisibleTo Include="Noovio.Pulse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noovio.Pulse.Infrastructure\Noovio.Pulse.Infrastructure.csproj" />
  </ItemGroup>

</Project>
