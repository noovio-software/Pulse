@* Fenêtre « Calculateur de talents » : les trois arbres côte à côte comme en jeu (classe, héros, spécialisation).
   Vue méta : colorés par le taux de sélection du top. Vue joueur (Selected) : ses choix comparés au top. *@

<div class="modal-backdrop" @onclick="OnClose">
    <section class="modal panel talent-modal" @onclick:stopPropagation @onkeydown="OnKeyDown" tabindex="-1" @ref="dialog"
             role="dialog" aria-modal="true" aria-labelledby="talent-modal-title" style="--class-color: @Spec.Color">
        <header class="modal-head">
            <img class="wow-icon" src="@Spec.IconUrl" alt="" width="40" height="40" />
            <div>
                <h2 id="talent-modal-title">@(Selected is null ? "Calculateur de talents" : "Tes talents face au top")</h2>
                <p class="muted">@Spec.SpecName @Spec.ClassName · méta des @SampleSize meilleurs @Site.Words.NounPlural</p>
            </div>
            <div class="talent-modal-actions">
                @if (LoadoutCode is not null)
                {
                    <a class="btn btn-primary" href="@Ui.TalentCalculatorUrl(LoadoutCode)" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                        </svg>
                        Ouvrir dans Wowhead
                    </a>
                    <CopyButton Text="@LoadoutCode" Label="Copier le code de talents" IconOnly />
                }
                <button type="button" class="btn btn-ghost btn-icon" @onclick="OnClose" aria-label="Fermer">✕</button>
            </div>
        </header>

        <ul class="talent-legend" aria-label="Légende">
            @if (Selected is null)
            {
                <li><span class="swatch is-core"></span>Incontournable (≥ 90 %)</li>
                <li><span class="swatch is-common"></span>Courant (≥ 50 %)</li>
                <li><span class="swatch is-situational"></span>Situationnel</li>
                <li><span class="swatch is-unpicked"></span>Jamais pris</li>
            }
            else
            {
                <li><span class="swatch is-match"></span>Ton choix, comme la majorité du top</li>
                <li><span class="swatch is-picked"></span>Ton choix, partagé par une partie du top</li>
                <li><span class="swatch is-atypical"></span>Ton choix, rare dans le top (&lt; 10 %)</li>
                <li><span class="swatch is-missing"></span>Incontournable que tu ne prends pas</li>
            }
        </ul>

        <div class="talent-trees">
            @if (Section(TalentTree.Class) is { } classTree)
            {
                <div class="tree-column">
                    <h3 class="tree-title">@classTree.Name</h3>
                    <TalentTreeView Section="classTree" Selected="Selected" />
                </div>
            }

            @if (HeroSections.Count > 0)
            {
                var hero = HeroSections.FirstOrDefault(h => h.Name == activeHero) ?? HeroSections[0];
                <div class="tree-column is-hero">
                    <div class="hero-switch" role="tablist" aria-label="Arbres héroïques">
                        @foreach (var h in HeroSections)
                        {
                            <button type="button" role="tab" class="hero-tab @(h == hero ? "is-active" : null)"
                                    aria-selected="@(h == hero ? "true" : "false")" @onclick="() => SelectHero(h.Name)">
                                @if (h.IconUrl is not null)
                                {
                                    <img src="@h.IconUrl" alt="" />
                                }
                                <span>@h.Name</span>
                                <strong>@Ui.Percent(h.Share)</strong>
                            </button>
                        }
                    </div>
                    <TalentTreeView Section="hero" Selected="Selected" />
                </div>
            }

            @if (Section(TalentTree.Spec) is { } specTree)
            {
                <div class="tree-column">
                    <h3 class="tree-title">@specTree.Name</h3>
                    <TalentTreeView Section="specTree" Selected="Selected" />
                </div>
            }
        </div>

        <p class="muted talent-note">
            @if (Selected is null)
            {
                <text>Chaque nœud affiche l'option la plus choisie et la part du top qui la prend. Pour un build exact, ouvre la configuration la plus jouée dans Wowhead.</text>
            }
            else
            {
                <text>Le chiffre sur chaque nœud est la part du top qui le prend. Ouvre ta configuration dans Wowhead pour la modifier.</text>
            }
        </p>
    </section>
</div>
