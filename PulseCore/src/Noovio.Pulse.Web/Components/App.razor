<!DOCTYPE html>
<html lang="@PulseLocalization.CurrentLanguage">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Titre et balises d'aperçu en tête : les applications de messagerie (Messenger, WhatsApp) qui construisent l'aperçu
       d'un lien ne lisent que le début de la page. Seul SharedReport y ajoute des balises : rien n'y change l'ordre des styles. *@
    <HeadOutlet />
    @* Couleur du navigateur mobile et de la barre des aperçus Discord : celle du site, ou celle d'une page (MainLayout, SharedReport). *@
    <SectionOutlet SectionName="theme-color" />
    <base href="@Navigation.BaseUri" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" />
    <link rel="stylesheet" href="@Assets["_content/Noovio.Pulse.Web/pulse.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Noovio.Pulse.Web/Noovio.Pulse.Web.bundle.scp.css"]" />
    @* Le thème de l'application redéfinit les jetons de couleur de pulse.css. *@
    <link rel="stylesheet" href="@Assets[$"{Site.Slug}/theme.css"]" />
    <ImportMap />
    <link rel="icon" href="@Assets[$"{Site.Slug}/favicon.ico"]" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="@Assets[$"{Site.Slug}/favicon.svg"]" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script>const whTooltips = { colorLinks: false, iconizeLinks: false, renameLinks: false };</script>
    <script src="https://wow.zamimg.com/js/tooltips.js" async></script>
    <script src="@Assets["_content/Noovio.Pulse.Web/pulse.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
