@page "/compte/personnages/{Id:long}/analyse"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@Ui.F(WebTexts.Report_PageTitle, analysis?.Character.Name ?? WebTexts.Report_Analysis, Site.Name)</PageTitle>

<TopBar Active="analysis?.Spec.Spec" />

<main class="shell">
    <a class="back-link" href="compte">@WebTexts.Report_MyCharacters</a>

@if (loading)
{
    <section class="panel empty-state">
        <div class="spinner"></div>
        <p>@WebTexts.Report_AccountLoading</p>
    </section>
}
else if (error is not null)
{
    <section class="panel empty-state">
        <h1>@WebTexts.Report_Failed</h1>
        <p>@error</p>
        <a class="btn" href="compte">@WebTexts.Common_Back</a>
    </section>
}
else if (analysis is { } a)
{
    <AnalysisReport Analysis="a" BasePath="@($"compte/personnages/{Id}/analyse")" RealmName="@character?.RealmName"
                    OnRefresh="() => LoadAsync(force: true)" RefreshTitle="@WebTexts.Report_AccountRefreshTitle">
        <Actions>
            @* La clé force un bouton neuf pour chaque analyse : un lien affiché ne survit pas à une relance. *@
            <ShareButton @key="a" CreateLink="() => ShareAsync(a)" />
        </Actions>
    </AnalysisReport>
}
</main>
