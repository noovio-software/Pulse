@page "/routes/{Slug}"

<PageTitle>@Ui.F(WebTexts.Report_PageTitle, dungeon is null ? WebTexts.Dungeon_Unknown : Ui.F(WebTexts.Dungeon_PageTitle, dungeon.Name), Site.Name)</PageTitle>

<TopBar RoutesActive />

<main class="shell">
    @if (dungeon is null)
    {
        <section class="panel empty-state">
            <h1>@WebTexts.Dungeon_Unknown</h1>
            <p>@WebTexts.Dungeon_UnknownText</p>
            <a class="btn" href="routes">@WebTexts.Home_AllRoutes</a>
        </section>
    }
    else
    {
        <section class="dungeon-hero">
            @if (dungeon.ImageUrl is { } image)
            {
                <img class="dungeon-hero-art" src="@image" alt="" />
            }
            <div class="dungeon-hero-text">
                <a class="dungeon-back" href="routes">@WebTexts.Dungeon_AllRoutes</a>
                <h1>@dungeon.Name</h1>
                <p>
                    <span>@Ui.SeasonLabel(dungeon.Season)</span>
                    <span>@Ui.F(WebTexts.Dungeon_Timer, Ui.KeyTimer(dungeon.TimerSeconds))</span>
                    <span>@Ui.F(WebTexts.Dungeon_RouteCount, dungeon.Routes.Count)</span>
                </p>
            </div>
            <nav class="dungeon-switch" aria-label="@WebTexts.Dungeon_Switch">
                @foreach (var other in dungeons)
                {
                    var isCurrent = other.Slug == dungeon.Slug;
                    <a class="@(isCurrent ? "is-active" : null)" href="routes/@other.Slug" title="@other.Name"
                       aria-label="@other.Name" aria-current="@(isCurrent ? "page" : null)">
                        @if (other.IconUrl is { } icon)
                        {
                            <img class="wow-icon" src="@icon" alt="" width="36" height="36" loading="lazy" />
                        }
                        else
                        {
                            @other.ShortName
                        }
                    </a>
                }
            </nav>
        </section>

        <div class="route-layout">
            <ol class="route-list" aria-label="@WebTexts.Dungeon_RouteList">
                @for (var i = 0; i < dungeon.Routes.Count; i++)
                {
                    var route = dungeon.Routes[i];
                    var isSelected = route.PublicKey == selected?.PublicKey;
                    <li>
                        <a class="route-row @(isSelected ? "is-selected" : null)" href="routes/@dungeon.Slug?route=@route.PublicKey#route"
                           aria-current="@(isSelected ? "true" : null)">
                            <span class="route-rank" aria-hidden="true">@(i + 1)</span>
                            <span class="route-row-text">
                                <strong>@route.Title</strong>
                                <span class="muted">@(route.Author ?? WebTexts.Dungeon_UnknownAuthor)</span>
                                <span class="route-row-facts">
                                    <span>@Ui.F(WebTexts.Dungeon_Pulls, route.PullSizes.Count)</span>
                                    <span>@Ui.F(WebTexts.Dungeon_LargestPull, route.LargestPull)</span>
                                    <span>@Ui.F(WebTexts.Dungeon_Forces, Ui.ForcesPercent(route))</span>
                                </span>
                                @if (highlights.GetValueOrDefault(route.PublicKey) is { Count: > 0 } tags)
                                {
                                    <span class="route-tags">
                                        @foreach (var tag in tags)
                                        {
                                            <span class="route-tag @Ui.HighlightCss(tag)">@Ui.HighlightLabel(tag)</span>
                                        }
                                    </span>
                                }
                            </span>
                        </a>
                    </li>
                }
            </ol>

            @if (selected is { } current)
            {
                <article class="panel route-detail" id="route">
                    <header class="route-detail-head">
                        <div>
                            <h2>@current.Title</h2>
                            <p class="muted">
                                @WebTexts.Dungeon_By
                                @if (current.AuthorUrl is { } authorUrl)
                                {
                                    <a href="@authorUrl" target="_blank" rel="noopener">@current.Author</a>
                                }
                                else
                                {
                                    @(current.Author ?? WebTexts.Dungeon_UnknownAuthorLower)
                                }
                                @WebTexts.Dungeon_OnKeystoneGuru
                            </p>
                        </div>
                        <a class="btn btn-primary" href="@current.ViewUrl" target="_blank" rel="noopener">
                            @WebTexts.Dungeon_Open
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                            </svg>
                        </a>
                    </header>

                    <dl class="route-stats">
                        <div><dt>@WebTexts.Dungeon_StatPulls</dt><dd>@current.PullSizes.Count</dd></div>
                        <div><dt>@WebTexts.Dungeon_StatLargest</dt><dd>@current.LargestPull <small>@WebTexts.Dungeon_Enemies</small></dd></div>
                        <div><dt>@WebTexts.Dungeon_StatAverage</dt><dd>@current.AveragePull.ToString("0.#")</dd></div>
                        <div><dt>@WebTexts.Dungeon_StatForces</dt><dd>@Ui.ForcesPercent(current)</dd></div>
                    </dl>

                    <PullRhythm Route="current" />

                    <div class="route-map">
                        <iframe src="@current.EmbedUrl" title="@Ui.F(WebTexts.Dungeon_MapTitle, current.Title)" loading="lazy" allowfullscreen></iframe>
                    </div>
                    <p class="route-mdt muted">@WebTexts.Dungeon_Mdt <a href="https://keystone.guru" target="_blank" rel="noopener">Keystone.guru</a>.</p>
                </article>
            }
        </div>
    }
</main>
