@page "/importer"

<PageTitle>@Ui.F(WebTexts.Import_PageTitle, Site.Name)</PageTitle>

<TopBar />

<main class="shell import-shell">
    <section class="panel import-head">
        <span class="eyebrow">@WebTexts.Import_Eyebrow</span>
        <h1>@WebTexts.Import_Title</h1>
        <p class="import-lead">
            @WebTexts.Import_Lead
        </p>

        <ol class="import-steps">
            <li>
                <span class="step-number" aria-hidden="true">1</span>
                <div>
                    <strong>@WebTexts.Import_Step1</strong>
                    <p>
                        @WebTexts.Import_Step1Before <a href="@AddonInfo.DownloadUrl" target="_blank" rel="noopener">NoovioPulse</a>@StepFolders
                    </p>
                </div>
            </li>
            <li>
                <span class="step-number" aria-hidden="true">2</span>
                <div>
                    <strong>@WebTexts.Import_Step2</strong>
                    <p>@WebTexts.Import_Step2Before <code>/noovio</code> @WebTexts.Import_Step2After</p>
                </div>
            </li>
            <li>
                <span class="step-number" aria-hidden="true">3</span>
                <div>
                    <strong>@WebTexts.Import_Step3</strong>
                    <p>@WebTexts.Import_Step3Before <kbd>Ctrl</kbd> + <kbd>C</kbd> @WebTexts.Import_Step3Middle <kbd>Ctrl</kbd> + <kbd>V</kbd> @WebTexts.Import_Step3After</p>
                </div>
            </li>
        </ol>
    </section>

    <section class="panel import-form">
        <EditForm Model="Input!" FormName="import" OnSubmit="SubmitAsync" method="post">
            <div class="import-label">
                <label for="import-text">@WebTexts.Import_Label</label>
                <span class="muted">@WebTexts.Import_StartsWith <code>NP1:</code></span>
            </div>
            <InputTextArea id="import-text" @bind-Value="Input!.Text" rows="7" spellcheck="false" autocomplete="off"
                           class="@(error is null ? null : "is-invalid")" placeholder="@WebTexts.Import_Placeholder"
                           aria-describedby="import-hint" aria-invalid="@(error is not null)" />
            @if (error is not null)
            {
                <p class="import-error" role="alert">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" />
                    </svg>
                    @error
                </p>
            }
            <div class="import-actions">
                <p id="import-hint" class="muted">
                    @Ui.F(WebTexts.Import_Retention, AddonInfo.Retention.TotalDays)
                </p>
                <button type="submit" class="btn btn-primary">
                    <CompareIcon />
                    @WebTexts.Import_Analyse
                </button>
            </div>
        </EditForm>
    </section>
</main>
