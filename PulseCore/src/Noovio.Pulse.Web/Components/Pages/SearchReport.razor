@page "/personnages/{Region}/{Realm}/{Name}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@Ui.F(WebTexts.Report_PageTitle, analysis?.Character.Name ?? WebTexts.Report_Analysis, Site.Name)</PageTitle>

<TopBar Active="analysis?.Spec.Spec" />

<main class="shell">
    <a class="back-link" href="@SearchUrl">@WebTexts.Report_NewSearch</a>

@if (loading)
{
    <section class="panel empty-state">
        <div class="spinner"></div>
        <p>@WebTexts.Report_AccountLoading</p>
    </section>
}
else if (error is not null)
{
    <section class="panel empty-state">
        <h1>@WebTexts.Report_Failed</h1>
        <p>@error</p>
        <a class="btn" href="@SearchUrl">@WebTexts.Report_RetrySearch</a>
    </section>
}
else if (analysis is { } a)
{
    <AnalysisReport Analysis="a" BasePath="@PathOf(Region, Realm, Name)" RealmName="@character?.RealmName"
                    OnRefresh="() => LoadAsync(force: true)" RefreshTitle="@WebTexts.Report_AccountRefreshTitle" />
}
</main>
