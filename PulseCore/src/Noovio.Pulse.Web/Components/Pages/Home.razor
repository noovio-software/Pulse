@page "/"

<PageTitle>@Ui.F(WebTexts.Home_PageTitle, Site.Name, Site.Words.Noun)</PageTitle>

<TopBar />

<main class="shell">
    @* --- Accroche : ce qu'est l'application, et les chiffres du dernier calcul ------------------- *@
    <section class="landing-hero">
        <div class="landing-pitch">
            <span class="landing-kicker">
                <span class="pulse-dot" aria-hidden="true"></span>
                @(season is null ? WebTexts.Common_MythicPlus : $"{Ui.SeasonLabel(season)} · {WebTexts.Common_MythicPlus}")
            </span>
            <h1 class="landing-title">@Ui.F(WebTexts.Home_Title, Site.Words.Noun) <em>@WebTexts.Home_TitleEmphasis</em></h1>
            <p class="landing-lead">
                @Ui.F(WebTexts.Home_Lead, Site.Name, Site.Words.NounPlural)
            </p>
            <div class="landing-actions">
                <CompareButton />
                <a class="btn btn-ghost" href="rechercher" title="@WebTexts.Home_SearchTitle">@WebTexts.Home_Search</a>
                <a class="btn btn-ghost" href="importer" title="@WebTexts.Home_ImportTitle">@WebTexts.Home_Import</a>
                <a class="btn btn-ghost" href="#specialisations">
                    @WebTexts.Home_SeeMeta
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14M6 13l6 6 6-6" />
                    </svg>
                </a>
                @if (dungeons.Count > 0)
                {
                    <a class="btn btn-ghost" href="routes">@WebTexts.Home_RoutesButton</a>
                }
            </div>
            <ul class="landing-proof">
                <li>@WebTexts.Home_ProofRaiderIo</li>
                <li>@WebTexts.Home_ProofBlizzard</li>
                @if (dungeons.Count > 0)
                {
                    <li>@WebTexts.Home_ProofKeystoneGuru</li>
                }
                <li>@WebTexts.Home_ProofRefresh</li>
            </ul>
        </div>

        <div class="panel landing-board" aria-label="@WebTexts.Home_BoardLabel">
            <div class="board-head">
                <span class="eyebrow">@WebTexts.Home_LastRun</span>
                <span class="board-live">@(lastUpdate is { } at ? Ui.Ago(at) : WebTexts.Home_Pending)</span>
            </div>
            <dl class="board-kpis">
                <div>
                    <dt>@Ui.F(WebTexts.Home_PlayersAnalysed, Ui.Capitalized(Site.Words.NounPlural))</dt>
                    <dd>@totalPlayers</dd>
                </div>
                <div>
                    <dt>@WebTexts.Home_Specs</dt>
                    <dd>@Site.Role.Specs.Count</dd>
                </div>
                <div>
                    <dt>@WebTexts.Home_MedianKey</dt>
                    <dd>@(medianKey > 0 ? $"+{medianKey}" : "-")</dd>
                </div>
                <div>
                    <dt>@WebTexts.Home_MedianIlvl</dt>
                    <dd>@Ui.Ilvl(medianItemLevel)</dd>
                </div>
            </dl>
            @if (bestRun is { } best)
            {
                <a class="board-record" href="specs/@best.Info.Slug" style="--class-color: @best.Info.Color">
                    <img class="wow-icon" src="@best.Info.IconUrl" alt="" width="36" height="36" />
                    <span class="board-record-text">
                        <span class="eyebrow">@WebTexts.Home_HighestKey</span>
                        <strong>@best.Player.Name</strong>
                        <span class="muted">@best.Info.SpecName @best.Info.ClassName · @best.Player.Region.ToUpperInvariant()</span>
                    </span>
                    <span class="board-record-key">+@best.Player.BestKeyLevel</span>
                </a>
            }
        </div>
    </section>

    @* --- Ce que contient une fiche de spécialisation ------------------------------------------ *@
    <section class="landing-features" aria-label="@Ui.F(WebTexts.Home_FeaturesLabel, Site.Name)">
        <article class="feature">
            <span class="feature-icon stat-haste"><StatIcon Stat="SecondaryStat.Haste" Size="20" /></span>
            <h2>@WebTexts.Home_FeatureStats</h2>
            <p>@WebTexts.Home_FeatureStatsText</p>
        </article>
        <article class="feature">
            <span class="feature-icon is-talents">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5" r="2.5" /><circle cx="6" cy="19" r="2.5" /><circle cx="18" cy="19" r="2.5" /><path d="M12 7.5v4M12 11.5l-5 5M12 11.5l5 5" />
                </svg>
            </span>
            <h2>@WebTexts.Home_FeatureTalents</h2>
            <p>@WebTexts.Home_FeatureTalentsText</p>
        </article>
        <article class="feature">
            <span class="feature-icon is-gear">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l8 3v6c0 4.5-3.4 7.8-8 9-4.6-1.2-8-4.5-8-9V6z" /><path d="M12 8v8M8.5 12h7" />
                </svg>
            </span>
            <h2>@WebTexts.Home_FeatureGear</h2>
            <p>@Ui.F(WebTexts.Home_FeatureGearText, Site.Words.RoleTrinket, Site.Words.DamageTrinket)</p>
        </article>
        <article class="feature">
            <span class="feature-icon is-compare"><CompareIcon Size="20" /></span>
            <h2>@WebTexts.Home_FeatureYou</h2>
            <p>@WebTexts.Home_FeatureYouBefore <a href="importer">@WebTexts.Home_FeatureYouLink</a>@WebTexts.Home_FeatureYouAfter</p>
        </article>
    </section>

    @* --- Tableau de bord des spécialisations ---------------------------------------------- *@
    <section class="landing-section" id="specialisations">
        <div class="landing-section-head">
            <h2 class="landing-heading">@Ui.F(WebTexts.Home_SpecsHeading, Site.Words.SpecCount)</h2>
            <p class="muted">@WebTexts.Home_SpecsLead</p>
        </div>

        <div class="spec-cards">
            @foreach (var (info, meta) in specs)
            {
                @* Le lien de la fiche couvre toute la carte (::after) ; le bouton de comparaison passe au-dessus. *@
                <article class="panel spec-card" style="--class-color: @info.Color">
                    <a class="spec-card-identity" href="specs/@info.Slug">
                        <img class="wow-icon spec-card-icon" src="@info.IconUrl" alt="" width="48" height="48" />
                        <span>
                            <span class="eyebrow">@info.ClassName</span>
                            <strong class="spec-card-name">@info.SpecName</strong>
                        </span>
                    </a>
                    @if (meta is null)
                    {
                        <span class="muted">@WebTexts.Home_AwaitingIngestion</span>
                    }
                    else
                    {
                        <dl class="spec-card-facts">
                            <div><dt>@WebTexts.Home_FactIlvl</dt><dd>@Ui.Ilvl(meta.MedianItemLevel)</dd></div>
                            <div><dt>@WebTexts.Home_FactKey</dt><dd>+@meta.MedianKeyLevel</dd></div>
                            <div><dt>@Ui.Capitalized(Site.Words.NounPlural)</dt><dd>@meta.SampleSize</dd></div>
                        </dl>
                        @if (meta.Stats.Count > 0)
                        {
                            <ol class="spec-card-stats" aria-label="@WebTexts.Home_StatPriority">
                                @foreach (var s in meta.Stats)
                                {
                                    <li class="@Ui.StatCss(s.Stat)" title="@Ui.F(WebTexts.Home_StatTitle, Ui.StatLabel(s.Stat), Ui.PercentValue(s.MedianPercent))">
                                        <StatIcon Stat="s.Stat" Size="14" />
                                        @if (s == meta.Stats[0])
                                        {
                                            <span>@Ui.StatLabel(s.Stat)</span>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        @if (meta.HeroTrees.FirstOrDefault() is { } hero)
                        {
                            <span class="spec-card-hero">
                                <HeroBadge Name="@hero.Name" IconUrl="@Ui.HeroIcon(meta.TalentTree, hero.Name)" />
                                <small class="muted">@Ui.F(WebTexts.Common_OfTop, Ui.Percent(hero.Share))</small>
                            </span>
                        }
                    }
                    <span class="spec-card-foot">
                        <span class="muted spec-card-updated">@(meta is null ? null : Ui.F(WebTexts.Home_Updated, Ui.Ago(meta.ComputedAtUtc)))</span>
                        <CompareButton Spec="info" Compact />
                    </span>
                </article>
            }
        </div>
    </section>

    @* --- Routes de la saison, pour les applications qui en ont ---------------------------------- *@
    @if (dungeons.Count > 0)
    {
        <section class="landing-section" id="routes">
            <div class="landing-section-head">
                <h2 class="landing-heading">@WebTexts.Home_RoutesHeading</h2>
                <p class="muted">@WebTexts.Home_RoutesLead <a href="routes">@WebTexts.Home_AllRoutes</a></p>
            </div>
            <DungeonGrid Dungeons="dungeons" />
        </section>
    }

    @* --- Comment c'est calculé ---------------------------------------------------------------- *@
    <section class="landing-section">
        <div class="landing-section-head">
            <h2 class="landing-heading">@WebTexts.Home_SourcesHeading</h2>
            <p class="muted">@WebTexts.Home_SourcesLead</p>
        </div>
        <ol class="landing-steps">
            <li>
                <span class="step-index">1</span>
                <h3>@WebTexts.Home_Step1</h3>
                <p>@Ui.F(WebTexts.Home_Step1Text, Site.Words.NounPlural)</p>
            </li>
            <li>
                <span class="step-index">2</span>
                <h3>@WebTexts.Home_Step2</h3>
                <p>@WebTexts.Home_Step2Text</p>
            </li>
            <li>
                <span class="step-index">3</span>
                <h3>@WebTexts.Home_Step3</h3>
                <p>@WebTexts.Home_Step3Text</p>
            </li>
            <li>
                <span class="step-index">4</span>
                <h3>@WebTexts.Home_Step4</h3>
                <p>@WebTexts.Home_Step4Text</p>
            </li>
        </ol>
    </section>

    <CompareCallout />
</main>
