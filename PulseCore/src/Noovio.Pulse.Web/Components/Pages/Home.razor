@page "/"

<PageTitle>@Site.Name by Noovio · Méta @Site.Words.Noun Mythique+</PageTitle>

<TopBar />

<main class="shell">
    @* --- Accroche : ce qu'est l'application, et les chiffres du dernier calcul ------------------- *@
    <section class="landing-hero">
        <div class="landing-pitch">
            <span class="landing-kicker">
                <span class="pulse-dot" aria-hidden="true"></span>
                @(season is null ? "Mythique+" : $"{Ui.SeasonLabel(season)} · Mythique+")
            </span>
            <h1 class="landing-title">Joue ton @Site.Words.Noun <em>comme le top 100</em></h1>
            <p class="landing-lead">
                @Site.Name lit les 100 meilleurs @Site.Words.NounPlural de chaque spécialisation en Mythique+ et en tire la méta :
                caractéristiques à viser, talents, équipement, bijoux et embellissements. Puis compare ton personnage
                à ce top, point par point.
            </p>
            <div class="landing-actions">
                <CompareButton />
                <a class="btn btn-ghost" href="importer" title="Coller la chaîne de l'addon NoovioPulse, sans connexion">Importer depuis l'addon</a>
                <a class="btn btn-ghost" href="#specialisations">
                    Voir la méta
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14M6 13l6 6 6-6" />
                    </svg>
                </a>
                @if (dungeons.Count > 0)
                {
                    <a class="btn btn-ghost" href="routes">Routes Midnight</a>
                }
            </div>
            <ul class="landing-proof">
                <li>Classements Raider.io</li>
                <li>Profils de l'API Blizzard</li>
                @if (dungeons.Count > 0)
                {
                    <li>Routes Keystone.guru</li>
                }
                <li>Recalculé toutes les 6 h</li>
            </ul>
        </div>

        <div class="panel landing-board" aria-label="Le dernier calcul en chiffres">
            <div class="board-head">
                <span class="eyebrow">Dernier calcul</span>
                <span class="board-live">@(lastUpdate is { } at ? Ui.Ago(at) : "en attente")</span>
            </div>
            <dl class="board-kpis">
                <div>
                    <dt>@Ui.Capitalized(Site.Words.NounPlural) analysés</dt>
                    <dd>@totalPlayers</dd>
                </div>
                <div>
                    <dt>Spécialisations</dt>
                    <dd>@Site.Role.Specs.Count</dd>
                </div>
                <div>
                    <dt>Clé médiane du top</dt>
                    <dd>@(medianKey > 0 ? $"+{medianKey}" : "-")</dd>
                </div>
                <div>
                    <dt>Niv. d'objet médian</dt>
                    <dd>@Ui.Ilvl(medianItemLevel)</dd>
                </div>
            </dl>
            @if (bestRun is { } best)
            {
                <a class="board-record" href="specs/@best.Info.Slug" style="--class-color: @best.Info.Color">
                    <img class="wow-icon" src="@best.Info.IconUrl" alt="" width="36" height="36" />
                    <span class="board-record-text">
                        <span class="eyebrow">Plus haute clé du top</span>
                        <strong>@best.Player.Name</strong>
                        <span class="muted">@best.Info.SpecName @best.Info.ClassName · @best.Player.Region.ToUpperInvariant()</span>
                    </span>
                    <span class="board-record-key">+@best.Player.BestKeyLevel</span>
                </a>
            }
        </div>
    </section>

    @* --- Ce que contient une fiche de spécialisation ------------------------------------------ *@
    <section class="landing-features" aria-label="Ce que @Site.Name décortique">
        <article class="feature">
            <span class="feature-icon stat-haste"><StatIcon Stat="SecondaryStat.Haste" Size="20" /></span>
            <h2>Caractéristiques</h2>
            <p>L'ordre de priorité du top et le pourcentage à viser, avec la fourchette où se situe la moitié des joueurs.</p>
        </article>
        <article class="feature">
            <span class="feature-icon is-talents">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5" r="2.5" /><circle cx="6" cy="19" r="2.5" /><circle cx="18" cy="19" r="2.5" /><path d="M12 7.5v4M12 11.5l-5 5M12 11.5l5 5" />
                </svg>
            </span>
            <h2>Talents</h2>
            <p>Les configurations les plus jouées, l'arbre héroïque dominant et un calculateur, chaîne d'export prête à copier.</p>
        </article>
        <article class="feature">
            <span class="feature-icon is-gear">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l8 3v6c0 4.5-3.4 7.8-8 9-4.6-1.2-8-4.5-8-9V6z" /><path d="M12 8v8M8.5 12h7" />
                </svg>
            </span>
            <h2>Équipement et bijoux</h2>
            <p>Les objets portés emplacement par emplacement, et les bijoux @Site.Words.RoleTrinket ou @Site.Words.DamageTrinket qui reviennent le plus.</p>
        </article>
        <article class="feature">
            <span class="feature-icon is-compare"><CompareIcon Size="20" /></span>
            <h2>Ton personnage</h2>
            <p>Connecte-toi avec Battle.net, ou <a href="importer">importe-le depuis l'addon NoovioPulse</a> : un score sur 100 et un plan d'action pour te rapprocher du top.</p>
        </article>
    </section>

    @* --- Tableau de bord des spécialisations ---------------------------------------------- *@
    <section class="landing-section" id="specialisations">
        <div class="landing-section-head">
            <h2 class="landing-heading">Les @Site.Words.SpecCount spécialisations</h2>
            <p class="muted">Le top 100 de chaque spécialisation, classé sur la meilleure clé de la saison.</p>
        </div>

        <div class="spec-cards">
            @foreach (var (info, meta) in specs)
            {
                @* Le lien de la fiche couvre toute la carte (::after) ; le bouton de comparaison passe au-dessus. *@
                <article class="panel spec-card" style="--class-color: @info.Color">
                    <a class="spec-card-identity" href="specs/@info.Slug">
                        <img class="wow-icon spec-card-icon" src="@info.IconUrl" alt="" width="48" height="48" />
                        <span>
                            <span class="eyebrow">@info.ClassName</span>
                            <strong class="spec-card-name">@info.SpecName</strong>
                        </span>
                    </a>
                    @if (meta is null)
                    {
                        <span class="muted">En attente de la première ingestion</span>
                    }
                    else
                    {
                        <dl class="spec-card-facts">
                            <div><dt>Niv.</dt><dd>@Ui.Ilvl(meta.MedianItemLevel)</dd></div>
                            <div><dt>Clé</dt><dd>+@meta.MedianKeyLevel</dd></div>
                            <div><dt>@Ui.Capitalized(Site.Words.NounPlural)</dt><dd>@meta.SampleSize</dd></div>
                        </dl>
                        @if (meta.Stats.Count > 0)
                        {
                            <ol class="spec-card-stats" aria-label="Priorité des caractéristiques">
                                @foreach (var s in meta.Stats)
                                {
                                    <li class="@Ui.StatCss(s.Stat)" title="@Ui.StatLabel(s.Stat) : @s.MedianPercent.ToString("0") % (médiane du top)">
                                        <StatIcon Stat="s.Stat" Size="14" />
                                        @if (s == meta.Stats[0])
                                        {
                                            <span>@Ui.StatLabel(s.Stat)</span>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        @if (meta.HeroTrees.FirstOrDefault() is { } hero)
                        {
                            <span class="spec-card-hero">
                                <HeroBadge Name="@hero.Name" IconUrl="@Ui.HeroIcon(meta.TalentTree, hero.Name)" />
                                <small class="muted">@Ui.Percent(hero.Share) du top</small>
                            </span>
                        }
                    }
                    <span class="spec-card-foot">
                        <span class="muted spec-card-updated">@(meta is null ? null : $"Mis à jour {Ui.Ago(meta.ComputedAtUtc)}")</span>
                        <CompareButton Spec="info" Compact />
                    </span>
                </article>
            }
        </div>
    </section>

    @* --- Routes de la saison, pour les applications qui en ont ---------------------------------- *@
    @if (dungeons.Count > 0)
    {
        <section class="landing-section" id="routes">
            <div class="landing-section-head">
                <h2 class="landing-heading">Les routes Midnight</h2>
                <p class="muted">Les routes les plus populaires de chaque donjon, avec la taille de leurs pulls. <a href="routes">Toutes les routes</a></p>
            </div>
            <DungeonGrid Dungeons="dungeons" />
        </section>
    }

    @* --- Comment c'est calculé ---------------------------------------------------------------- *@
    <section class="landing-section">
        <div class="landing-section-head">
            <h2 class="landing-heading">D'où viennent les chiffres</h2>
            <p class="muted">Aucune opinion, aucun guide recopié : uniquement ce que jouent les meilleurs.</p>
        </div>
        <ol class="landing-steps">
            <li>
                <span class="step-index">1</span>
                <h3>Le classement</h3>
                <p>Les meilleurs @Site.Words.NounPlural de chaque spécialisation, donjon par donjon et région par région, d'après Raider.io.</p>
            </li>
            <li>
                <span class="step-index">2</span>
                <h3>Les profils</h3>
                <p>Équipement, caractéristiques et talents de chaque joueur, lus sur l'API Blizzard.</p>
            </li>
            <li>
                <span class="step-index">3</span>
                <h3>La méta</h3>
                <p>Médianes, taux de sélection et combinaisons les plus jouées, recalculés toutes les 6 heures.</p>
            </li>
            <li>
                <span class="step-index">4</span>
                <h3>Ta comparaison</h3>
                <p>Ton personnage face à cette méta : ce qui est bon, ce qui est à améliorer, par ordre d'importance.</p>
            </li>
        </ol>
    </section>

    <CompareCallout />
</main>
