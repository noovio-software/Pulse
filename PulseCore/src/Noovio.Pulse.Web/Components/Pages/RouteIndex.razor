@page "/routes"

<PageTitle>@Ui.F(WebTexts.Routes_PageTitle, Site.DisplayName)</PageTitle>

<TopBar RoutesActive />

<main class="shell">
    <section class="routes-hero">
        @if (dungeons.Count > 0)
        {
            <span class="routes-kicker">@Ui.SeasonLabel(dungeons[0].Season) · @WebTexts.Common_MythicPlus</span>
        }
        <h1 class="routes-title">@WebTexts.Routes_Title <em>@WebTexts.Routes_TitleEmphasis</em>@WebTexts.Routes_TitleAfter</h1>
        <p class="routes-lead">
            @WebTexts.Routes_Lead
        </p>
        @if (lastUpdate is { } at)
        {
            <p class="routes-source muted">
                @WebTexts.Routes_SourceBefore <a href="https://keystone.guru" target="_blank" rel="noopener">Keystone.guru</a>@Ui.F(WebTexts.Routes_SourceAfter, Ui.Ago(at))
            </p>
        }
    </section>

    @if (dungeons.Count == 0)
    {
        <section class="panel empty-state">
            <h2>@WebTexts.Routes_None</h2>
            <p>@WebTexts.Routes_NoneText</p>
            <a class="btn" href=".">@WebTexts.Common_Back</a>
        </section>
    }
    else
    {
        <DungeonGrid Dungeons="dungeons" />
    }
</main>
