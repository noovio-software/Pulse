@page "/Error"

<PageTitle>@Ui.F(WebTexts.Error_PageTitle, Site.Name)</PageTitle>

<TopBar />

<main class="shell">
    <section class="panel empty-state">
        <h1>@WebTexts.Error_Title</h1>
        <p>@Site.Words.ServerError</p>
        @if (ShowRequestId)
        {
            <p class="muted">@WebTexts.Error_RequestId <code>@RequestId</code></p>
        }
        <a class="btn" href="/">@WebTexts.Common_Back</a>
    </section>
</main>
