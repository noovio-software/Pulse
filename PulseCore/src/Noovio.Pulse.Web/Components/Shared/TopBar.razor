@* En-tête compact : logo à gauche, une icône par spécialisation du rôle (infobulle au survol), ou un menu par classe quand il y en a trop, prochain rechargement, actions de la page à droite. *@

<header class="topbar">
    <a class="brand" href="/">
        <Sigil />
        <span class="brand-wordmark">
            <span class="brand-name">@Site.Name</span>
            <span class="brand-by">by Noovio</span>
        </span>
        <span class="brand-tag">Méta @Site.Words.Noun · Mythique+</span>
    </a>

    @if (Site.HasDungeonRoutes)
    {
        <a class="topbar-link @(RoutesActive ? "is-active" : null)" href="routes" aria-current="@(RoutesActive ? "page" : null)">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="19" r="2.5" /><circle cx="18" cy="5" r="2.5" /><path d="M8.5 19H15a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h6.5" />
            </svg>
            Routes
        </a>
    }

    @if (Site.Role.Specs.Count <= InlineNavLimit)
    {
        <nav class="spec-nav" aria-label="Spécialisations">
            @foreach (var info in Site.Role.Specs)
            {
                <a class="spec-link @(info.Spec == Active ? "is-active" : null)" href="specs/@info.Slug"
                   style="--class-color: @info.Color" aria-current="@(info.Spec == Active ? "page" : null)"
                   aria-label="@info.SpecName, @info.ClassName">
                    <img class="spec-nav-icon" src="@info.IconUrl" alt="" width="30" height="30" />
                    <span class="spec-tip" aria-hidden="true">
                        <strong>@info.SpecName</strong>
                        <span>@info.ClassName</span>
                    </span>
                </a>
            }
        </nav>
    }
    else
    {
        @* Trop de spécialisations pour une rangée d'icônes (DPS) : un menu, une ligne par classe. pulse.js le referme. *@
        var current = Site.Role.Specs.FirstOrDefault(s => s.Spec == Active);
        <details class="spec-menu">
            <summary class="spec-menu-toggle" style="--class-color: @(current?.Color ?? "var(--accent)")">
                @if (current is not null)
                {
                    <img class="spec-nav-icon" src="@current.IconUrl" alt="" width="30" height="30" />
                    <span class="spec-menu-label">
                        <strong>@current.SpecName</strong>
                        <small>@current.ClassName</small>
                    </span>
                }
                else
                {
                    <span class="spec-menu-grid" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" />
                        </svg>
                    </span>
                    <span class="spec-menu-label">
                        <strong>Spécialisations</strong>
                        <small>@Site.Role.Specs.Count au total</small>
                    </span>
                }
                <svg class="spec-menu-chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </summary>
            <nav class="spec-menu-panel" aria-label="Spécialisations">
                @foreach (var group in Site.Role.Specs.GroupBy(s => s.ClassId))
                {
                    <div class="spec-menu-class" style="--class-color: @group.First().Color">
                        <span class="spec-menu-class-name">@group.First().ClassName</span>
                        <div class="spec-menu-specs">
                            @foreach (var info in group)
                            {
                                <a class="spec-menu-link @(info.Spec == Active ? "is-active" : null)" href="specs/@info.Slug"
                                   aria-current="@(info.Spec == Active ? "page" : null)">
                                    <img class="spec-nav-icon" src="@info.IconUrl" alt="" width="26" height="26" loading="lazy" />
                                    <span>@info.SpecName</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </nav>
        </details>
    }

    @if (nextRefresh is { } next)
    {
        var paris = RefreshSchedule.ToParis(next);
        var remaining = next - DateTimeOffset.UtcNow;
        <span class="next-refresh" title="Données recalculées toutes les 6 h depuis Raider.io et l'API Blizzard. Prochaine ingestion prévue le @paris.ToString("dddd d MMMM à HH:mm") (heure de Paris).">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /><path d="M12 7v5l3 2" />
            </svg>
            <span class="next-refresh-text">
                <span class="eyebrow">Prochaine mise à jour</span>
                @if (remaining <= TimeSpan.Zero)
                {
                    <strong>Imminente</strong>
                }
                else
                {
                    <strong>@paris.ToString("HH'h'mm") <small>@Ui.In(remaining)</small></strong>
                }
            </span>
        </span>
    }

    <div class="topbar-actions">
        @ChildContent
        <AuthorizeView>
            <Authorized>
                <a class="account-link" href="compte" title="Mes personnages">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
                    </svg>
                    <span class="account-name">@context.User.Identity?.Name</span>
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-bnet" href="compte/connexion?returnUrl=%2Fcompte" data-enhance-nav="false">
                    <BattleNetLogo />
                    <span>Connexion</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>
