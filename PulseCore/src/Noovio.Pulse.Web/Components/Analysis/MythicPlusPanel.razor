@* Mythique+ (Raider.io) : score, rangs dans le rôle, meilleure clé par donjon ; les donjons faibles et absents ressortent. *@

@if (MythicPlus is null)
{
    <p class="muted">Raider.io ne connaît pas encore ce personnage pour la saison.</p>
}
else
{
    <div class="mplus-head">
        <div class="mplus-score" style="color: @(MythicPlus.ScoreColor ?? "var(--amber)")">
            <strong>@MythicPlus.Score.ToString("0")</strong>
            <span class="eyebrow">Score M+</span>
        </div>
        <dl class="mplus-facts">
            <div><dt>Score @Site.Words.Noun</dt><dd>@MythicPlus.RoleScore.ToString("0")</dd></div>
            @if (MythicPlus.RoleRankWorld is > 0)
            {
                <div><dt>Rang @Site.Words.Noun mondial</dt><dd>@MythicPlus.RoleRankWorld.Value.ToString("N0")</dd></div>
            }
            @if (MythicPlus.ClassRoleRankWorld is > 0)
            {
                <div><dt>Rang de la classe</dt><dd>@MythicPlus.ClassRoleRankWorld.Value.ToString("N0")</dd></div>
            }
        </dl>
        @if (MythicPlus.ProfileUrl is not null)
        {
            <a class="btn btn-ghost mplus-link" href="@MythicPlus.ProfileUrl" target="_blank" rel="noopener">Raider.io</a>
        }
    </div>

    <ul class="mplus-runs">
        @foreach (var run in MythicPlus.BestRuns)
        {
            <li class="@(run.Upgrades == 0 ? "is-depleted" : null) @(run.Level <= Median - 2 ? "is-weak" : null)">
                <a href="@run.Url" target="_blank" rel="noopener" title="@run.Dungeon">
                    <span class="run-short">@run.ShortName</span>
                    <strong class="run-level">+@run.Level</strong>
                    <span class="run-stars">@(run.Upgrades > 0 ? new string('★', Math.Min(run.Upgrades, 3)) : "hors temps")</span>
                </a>
            </li>
        }
        @foreach (var dungeon in MythicPlus.MissingDungeons)
        {
            <li class="is-missing" title="@dungeon : jamais fait cette saison">
                <span class="run-short">@dungeon</span>
                <strong class="run-level">—</strong>
                <span class="run-stars">à faire</span>
            </li>
        }
    </ul>
}
