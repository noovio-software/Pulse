@* Roadmap de farm : les instances dans l'ordre et le butin à y chercher, puis ce qui se joue hors du journal et les pièces à améliorer. *@

@if (!Roadmap.HasJournal)
{
    <p class="farm-note">Le Journal d'aventure n'a pas pu être lu : les pièces visées sont listées sans leur source. Relance l'analyse dans un instant.</p>
}

@if (Roadmap.Stops.Count == 0 && Roadmap.Elsewhere.Count == 0 && Roadmap.Upgrades.Count == 0)
{
    <p class="farm-ok">Rien à farmer : tes pièces sont celles du top, à un niveau d'objet comparable.</p>
}

@if (Roadmap.Stops.Count > 0)
{
    <ol class="farm-stops">
        @foreach (var (stop, index) in Roadmap.Stops.Select((s, i) => (s, i)))
        {
            <li class="farm-stop">
                <span class="stop-rank">@(index + 1)</span>
                <div class="stop-body">
                    <header>
                        <strong>@stop.Instance</strong>
                        <span class="stop-kind">@Ui.InstanceKindLabel(stop.Kind)</span>
                        @if (stop.KeyIsMissing)
                        {
                            <span class="stop-key is-bad">Jamais fait : compte aussi pour ton score</span>
                        }
                        else if (stop.KeyIsWeak)
                        {
                            <span class="stop-key is-warn">Clé en retard (+@stop.BestKeyLevel) : compte aussi pour ton score</span>
                        }
                        else if (stop.BestKeyLevel is { } level)
                        {
                            <span class="stop-key">Ta meilleure clé : +@level</span>
                        }
                    </header>
                    <ul class="farm-targets">
                        @foreach (var target in stop.Targets)
                        {
                            <FarmTargetRow Target="target" />
                        }
                    </ul>
                </div>
            </li>
        }
    </ol>
}

@if (Roadmap.Elsewhere.Count > 0)
{
    <h3 class="farm-title">Hors donjons et raids listés <small>craft, catalyseur… : le journal ne donne pas de source</small></h3>
    <ul class="farm-targets">
        @foreach (var target in Roadmap.Elsewhere)
        {
            <FarmTargetRow Target="target" />
        }
    </ul>
}

@if (Roadmap.Upgrades.Count > 0)
{
    <h3 class="farm-title">Bonnes pièces, à améliorer <small>même pièce, avec des écus ou la Grande chambre forte</small></h3>
    <ul class="farm-upgrades">
        @foreach (var upgrade in Roadmap.Upgrades)
        {
            <li>
                <a href="@Ui.ItemUrl(upgrade.ItemId)" data-wowhead="@Ui.ItemWowhead(upgrade.ItemId)" target="_blank" rel="noopener">
                    @if (upgrade.IconUrl is not null)
                    {
                        <img class="wow-icon" src="@upgrade.IconUrl" alt="" loading="lazy" />
                    }
                    @upgrade.Name
                </a>
                <span class="upgrade-gap">@upgrade.CurrentItemLevel → @upgrade.TargetItemLevel</span>
            </li>
        }
    </ul>
}
