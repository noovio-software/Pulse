<Project Sdk="Microsoft.NET.Sdk">

  <!-- Noms de classes et de spécialisations, vocabulaire des rôles : français (neutre) et anglais. La classe d'accès GameTexts.Designer.cs est versionnée à côté du .resx ; l'IDE la régénère quand on enregistre le .resx. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\GameTexts.resx" Generator="ResXFileCodeGenerator" LastGenOutput="GameTexts.Designer.cs" />
    <Compile Update="Resources\GameTexts.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="GameTexts.resx" />
    <!-- Les tests vérifient que chaque texte existe dans les deux langues. -->
    <InternalsVisibleTo Include="Noovio.Pulse.Tests" />
  </ItemGroup>

</Project>
