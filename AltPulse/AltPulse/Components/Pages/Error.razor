@page "/Error"
@using AltPulse.Client.Components

<PageTitle>Erreur · AltPulse by Noovio</PageTitle>

<TopBar />

<main class="shell">
    <section class="panel empty-state">
        <h1>Une erreur est survenue</h1>
        <p>Le venin a coulé au mauvais endroit. Réessaie dans un instant.</p>
        @if (ShowRequestId)
        {
            <p class="muted">Identifiant de la requête : <code>@RequestId</code></p>
        }
        <a class="btn" href="/">Retour</a>
    </section>
</main>
