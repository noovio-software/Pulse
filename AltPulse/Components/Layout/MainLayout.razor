@inherits LayoutComponentBase
@using AltPulse.Client.Components

<div class="venom-backdrop" aria-hidden="true"></div>

@* Chaque page rend sa propre <TopBar> (l'en-tête porte des actions interactives propres à la page). *@
@Body

<footer class="footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <Sigil Size="24" />
            <span class="brand-wordmark">
                <span class="brand-name">AltPulse</span>
                <span class="brand-by">by Noovio</span>
            </span>
        </div>

        <div class="footer-sources">
            <span class="eyebrow">Données</span>
            <a class="source" href="https://raider.io" target="_blank" rel="noopener">
                <span class="source-dot" aria-hidden="true"></span> Raider.io
            </a>
            <a class="source" href="https://develop.battle.net" target="_blank" rel="noopener">
                <span class="source-dot" aria-hidden="true"></span> API Blizzard
            </a>
        </div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>
