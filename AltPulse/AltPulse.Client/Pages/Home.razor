@page "/"
@rendermode InteractiveAuto

<PageTitle>AltPulse by Noovio · Suivi de personnages</PageTitle>

<TopBar>
    @if (season?.Affixes is { } affixes)
    {
        <ul class="affixes" aria-label="Affixes de la semaine">
            @foreach (var a in affixes.Affixes)
            {
                <li tabindex="0">
                    @if (a.IconUrl is not null)
                    {
                        <img src="@a.IconUrl" alt="@a.Name" loading="lazy" />
                    }
                    <span class="affix-tooltip" role="tooltip">
                        <strong>@a.Name</strong>
                        @a.Description
                    </span>
                </li>
            }
        </ul>
    }
    @if (season is not null)
    {
        <span class="reset-info" title="Prochaine réinitialisation hebdomadaire (@season.Region.ToUpperInvariant())">
            <span class="eyebrow">Réinitialisation</span>
            <strong>@Ui.Countdown(season.NextResetUtc)</strong>
        </span>
    }
    <button class="btn btn-primary btn-search" type="button" @onclick="OpenSearch" disabled="@(!ready)" aria-label="Rechercher un personnage">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" />
            <path d="m20 20-4-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <span class="btn-search-label">Rechercher</span>
    </button>
</TopBar>

@if (searchOpen)
{
<div class="modal-backdrop" @onclick="CloseSearch">
<section class="modal panel search-modal" @onclick:stopPropagation @onkeydown="OnSearchKeyDown"
         role="dialog" aria-modal="true" aria-labelledby="search-title">
    <header class="modal-head">
        <div>
            <h2 id="search-title" class="title">Rechercher un personnage</h2>
            <p class="subtitle">Il rejoint ton historique et la grille de suivi.</p>
        </div>
        <button type="button" class="btn btn-ghost close" @onclick="CloseSearch" aria-label="Fermer">✕</button>
    </header>

    <form class="search-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label class="field field-region">
            <span>Région</span>
            <select value="@region" @onchange="OnRegionChangedAsync" disabled="@(!ready)">
                @foreach (var r in Regions.All)
                {
                    <option value="@r">@r.ToUpperInvariant()</option>
                }
            </select>
        </label>

        <label class="field field-realm">
            <span>Royaume</span>
            <input @bind="realm" list="realm-list" placeholder="Hyjal, Archimonde…" autocomplete="off" disabled="@(!ready)" />
            <datalist id="realm-list">
                @foreach (var r in realms)
                {
                    <option value="@r.Name"></option>
                }
            </datalist>
        </label>

        <label class="field field-name">
            <span>Personnage</span>
            <input @ref="nameInput" @bind="name" placeholder="Nom du personnage" autocomplete="off" disabled="@(!ready)" />
        </label>

        <button class="btn btn-primary" type="submit" disabled="@(!ready || searching)">
            @(searching ? "Recherche…" : "Rechercher")
        </button>
    </form>

    <div class="history-row">
        <label class="field field-history">
            <span>Historique (@history.Count)</span>
            <select value="@selectedHistoryKey" @onchange="OnHistorySelectedAsync" disabled="@(!ready || history.Count == 0)">
                <option value="">@(history.Count == 0 ? "Aucune recherche pour l'instant" : "- Choisir un personnage -")</option>
                @foreach (var h in history)
                {
                    <option value="@h.Key">@h.Label</option>
                }
            </select>
        </label>
        <button class="btn btn-ghost" type="button" @onclick="ClearHistoryAsync" disabled="@(history.Count == 0)">Vider l'historique</button>
    </div>

    @if (searchError is not null)
    {
        <p class="alert">@searchError</p>
    }
</section>
</div>
}

<main class="shell">
@if (!ready)
{
    <section class="panel empty-state"><div class="spinner"></div><p>Ouverture de l'Abîme…</p></section>
}
else if (columns.Count == 0)
{
    <section class="panel empty-state">
        <h2>Aucun personnage suivi</h2>
        <p>Lance une recherche : chaque personnage trouvé est mémorisé sur ce poste.</p>
        <button class="btn btn-primary" type="button" @onclick="OpenSearch">Rechercher un personnage</button>
    </section>
}
else
{
    <CharacterGrid Season="season"
                   Columns="SortedColumns"
                   HighlightKey="@highlightKey"
                   SortBy="@settings.SortBy"
                   OnSortChanged="OnSortChangedAsync"
                   Compact="labelsCompact"
                   OnToggleCompact="ToggleCompactAsync"
                   CollapsedSections="settings.CollapsedSections"
                   OnToggleSection="ToggleSectionAsync"
                   OnRefresh="c => LoadColumnAsync(c, forceRefresh: true)"
                   OnRemove="RemoveAsync"
                   OnShowEquipment="c => equipmentFor = c.Data" />
}
</main>

@if (equipmentFor is not null)
{
    <EquipmentDialog Character="equipmentFor" OnClose="() => equipmentFor = null" />
}
