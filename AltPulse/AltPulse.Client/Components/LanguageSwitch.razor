@using System.Globalization
@* Bascule de langue : un lien par autre langue, rechargement complet pour que le rendu interactif reparte dans la nouvelle. *@
<nav class="language-switch" aria-label="@AltTexts.Language_Label">
    @foreach (var culture in AltLocalization.Cultures.Where(c => c != AltLocalization.CurrentLanguage))
    {
        var info = CultureInfo.GetCultureInfo(culture);
        <a class="language-link" href="@AltLocalization.SwitchUrl(culture, Nav.ToBaseRelativePath(Nav.Uri))"
           hreflang="@culture" lang="@culture" title="@(char.ToUpper(info.NativeName[0], info) + info.NativeName[1..])"
           rel="nofollow" data-enhance-nav="false">
            @culture.ToUpperInvariant()
        </a>
    }
</nav>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
