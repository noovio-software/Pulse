<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Textes neutres en français, anglais en assembly satellite. -->
    <NeutralLanguage>fr</NeutralLanguage>
    <!-- La culture est choisie au démarrage (Program.cs) : toutes les données de globalisation doivent être disponibles. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- Textes de l'interface, en français (neutre) et en anglais. Classe publique : le serveur s'en sert pour ses messages. -->
  <ItemGroup>
    <!-- AltTexts.Designer.cs est versionné à côté du .resx ; l'IDE le régénère quand on enregistre le .resx. -->
    <EmbeddedResource Update="Resources\AltTexts.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="AltTexts.Designer.cs" />
    <Compile Update="Resources\AltTexts.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="AltTexts.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
  </ItemGroup>

</Project>
