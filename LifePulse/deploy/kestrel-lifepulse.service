[Unit]
Description=LifePulse by Noovio - site (Kestrel)
After=network.target postgresql.service

[Service]
WorkingDirectory=/home/ubuntu/projects/lifepulse/web
ExecStart=/usr/bin/dotnet /home/ubuntu/projects/lifepulse/web/Noovio.LifePulse.Web.dll --urls http://127.0.0.1:8530
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=lifepulse
User=ubuntu
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=true
# Secrets hors de l'unité (lisible par tous) : fichier root:root 600.
EnvironmentFile=/etc/lifepulse/lifepulse.env

[Install]
WantedBy=multi-user.target
