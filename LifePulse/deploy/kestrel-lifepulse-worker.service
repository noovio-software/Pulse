[Unit]
Description=LifePulse by Noovio - ingestion toutes les 6 h (worker)
After=network.target postgresql.service

[Service]
WorkingDirectory=/home/ubuntu/projects/lifepulse/worker
ExecStart=/usr/bin/dotnet /home/ubuntu/projects/lifepulse/worker/Noovio.LifePulse.Worker.dll
Restart=always
RestartSec=30
KillSignal=SIGINT
SyslogIdentifier=lifepulse-worker
User=ubuntu
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=true
EnvironmentFile=/etc/lifepulse/lifepulse.env

[Install]
WantedBy=multi-user.target
