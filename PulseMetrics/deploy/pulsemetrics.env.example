# Copie dans /etc/pulsemetrics/pulsemetrics.env (root:root 600), chargée par kestrel-pulsemetrics.service (EnvironmentFile=).
# Pas de guillemets : systemd lit les valeurs telles quelles. Les « __ » remplacent les « : » de la configuration .NET.
# Sur le VPS existant, setup-server.sh remplit ce fichier depuis /etc/frontpulse, /etc/lifepulse et /etc/burstpulse.

# Une base par outil (bases existantes), ou une seule base avec un schéma par outil (« ;Search Path=front,public ») :
# l'application crée le schéma manquant et applique ses migrations dedans.
ConnectionStrings__FrontPulse=Host=localhost;Port=5432;Database=frontpulse;Username=frontpulse;Password=CHANGE_ME
ConnectionStrings__LifePulse=Host=localhost;Port=5432;Database=lifepulse;Username=lifepulse;Password=CHANGE_ME
ConnectionStrings__BurstPulse=Host=localhost;Port=5432;Database=burstpulse;Username=burstpulse;Password=CHANGE_ME

# Base d'usage commune (benchs), lue par PulseMetrics Admin. Sans elle, rien n'est enregistré.
ConnectionStrings__PulseUsage=Host=localhost;Port=5432;Database=pulseusage;Username=pulseusage;Password=CHANGE_ME

# Optionnel : sans Redis (pas installé sur le VPS), le cache reste en mémoire du processus.
#ConnectionStrings__Redis=localhost:6379

# Un seul client Battle.net pour les API et la connexion. Y déclarer les adresses de retour :
#   https://pulsemetrics.fr/front/signin-battlenet, /life/signin-battlenet, /burst/signin-battlenet
Blizzard__ClientId=CHANGE_ME
Blizzard__ClientSecret=CHANGE_ME

# Compte Keystone.guru (routes de donjons de Front). Sans lui, les pages de routes restent vides.
KeystoneGuru__Email=CHANGE_ME
KeystoneGuru__Password=CHANGE_ME

# Clés de chiffrement des cookies de connexion : sans elles, chaque déploiement déconnecte tout le monde.
DataProtection__KeysPath=/var/lib/pulsemetrics/keys

# Ingestion forcée (en-tête X-Admin-Key) et BattleTags admin (page /admin/ingestion), un par index à partir de 0.
Admin__ApiKey=CHANGE_ME
#Admin__BattleTags__0=Pseudo#1234
