<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- PulseMetrics : un seul exécutable pour la page d'accueil (/), Alt (/alt/), Front (/front/), Life (/life/) et Burst (/burst/).
       Seul le client WebAssembly d'Alt reste un projet à part (le SDK BlazorWebAssembly l'exige) ; le moteur commun vit dans PulseCore. -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Les secrets locaux de l'ancien site FrontPulse (Blizzard, base) : rien à ressaisir en développement. -->
    <UserSecretsId>9a4e1b7c-3d2f-4e8a-b6c5-1f0d9e2a7b34</UserSecretsId>

    <!-- VERSION=x.y.z est posée par GitHub Actions (à partir du tag) ; MSBuild lit les variables d'environnement
         comme des propriétés. En local, sans variable VERSION, la version est 1.0.0. -->
    <Version>$(Version)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PulseCore\src\Noovio.Pulse.Web\Noovio.Pulse.Web.csproj" />
    <ProjectReference Include="..\PulseMetrics.Alt.Client\PulseMetrics.Alt.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(PulseExtensionsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(PulseExtensionsVersion)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Textes de la page d'accueil, en français (neutre) et en anglais. La classe d'accès LandingTexts.Designer.cs est
       versionnée à côté du .resx ; l'IDE la régénère quand on enregistre le .resx. -->
  <ItemGroup>
    <EmbeddedResource Update="Landing\Resources\LandingTexts.resx" Generator="ResXFileCodeGenerator" LastGenOutput="LandingTexts.Designer.cs" />
    <Compile Update="Landing\Resources\LandingTexts.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="LandingTexts.resx" />
  </ItemGroup>

</Project>
