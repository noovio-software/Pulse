{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "PulseMetrics": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:8580",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "PulseMetrics (sans workers)": {
      "commandName": "Project",
      "commandLineArgs": "--no-workers",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:8580",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
