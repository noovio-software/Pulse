@page "/Error"
@using PulseMetrics.Alt.Client.Components

<PageTitle>@AltTexts.ErrorPage_Title</PageTitle>

<TopBar />

<main class="shell">
    <section class="panel empty-state">
        <h1>@AltTexts.ErrorPage_Heading</h1>
        <p>@AltTexts.ErrorPage_Text</p>
        @if (ShowRequestId)
        {
            <p class="muted">@AltTexts.ErrorPage_RequestId <code>@RequestId</code></p>
        }
        <a class="btn" href=".">@AltTexts.Common_Back</a>
    </section>
</main>
